    %r = call ptr memcpy(%dst, %src, %nbytes)
    %cm = and i64 diff, 63
    %blank = shl i64 -1, %cm
    %nb = sub i64 0, %blank
    %keep = sub i64 %nb, 1
    %last = sub i64 %keylen, 1
    %off = mul i64 %last, 8
    %addr = gep i8 %s0, %off
    %pp = gep i8 %addr, 24
    %v = load i64, %pp
    %v2 = and i64 %v, %keep
    store i64 %pp, %v2
    br side(edit, sc, scsegs, diff, n0)
  nopresc(edit: ptr, sc: ptr, scsegs: i64, diff: i64, n0: ptr, n0v: i64):
