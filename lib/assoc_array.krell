    %np = gep i8 %s0, 16
    store i64 %np, %n0t
    %kp = gep i8 %s0, 12
    %d32 = trunc i32 diff
    store i32 %kp, %d32
    store i64 %n0, %tag
    %tp0 = gep i8 n0, 8
    store i8 %tp0, 0
    %src = gep i8 %sc, 24
    %dst = gep i8 %s0, 24
