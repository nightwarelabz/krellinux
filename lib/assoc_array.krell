    br diss_loop(edit, ops, key, node, level, n0, n1, 1, 0, %base)
  diss_loop(edit: ptr, ops: ptr, key: ptr, node: ptr, level: i64, n0: ptr, n1: ptr, i: i64, d: i64, base: i64):
