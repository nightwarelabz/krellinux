    %spp = gep i8 edit, 296
    %ss8 = trunc i8 scslot
    store i8 %spp, %ss8
    %sbp = call i64 kla_ptrval(%side)
    call void kla_edit_st(edit, 272, %sbp)
    %n0v = call i64 kla_ptrval(n0)
    %n0t = or i64 %n0v, 1
    call void kla_edit_st(edit, 280, %n0t)
    br leafp(edit, n0, scslot)
  leafp(edit: ptr, n0: ptr, scslot: i64):
    %z = icmp.eq i64 %scslot, 0
    condbr %z, leaf1(edit, n0), leaf0(edit, n0)
  leaf1(edit: ptr, n0: ptr):
    %addr = gep i8 n0, 24
    %av = call i64 kla_ptrval(%addr)
    call void kla_edit_st(edit, 48, %av)
    ret 1
  leaf0(edit: ptr, n0: ptr):
    %addr = gep i8 n0, 16
