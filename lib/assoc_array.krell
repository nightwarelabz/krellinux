    %n0 = call ptr kla_kzalloc(152)
    %n0v = call i64 kla_ptrval(%n0)
    %z = icmp.eq i64 %n0v, 0
    condbr %z, fail(), have(edit, sc, level, sclevel, scsegs, diff, %n0, %n0v)
  have(edit: ptr, sc: ptr, level: i64, sclevel: i64, scsegs: i64, diff: i64, n0: ptr, n0v: i64):
    %tag = or i64 n0v, 1
    call void kla_edit_st(edit, 64, %tag)
    call void kla_edit_st(edit, 240, n0v)
    %l1 = add i64 level, 4
    %gt = icmp.sgt i64 diff, %l1
    condbr %gt, presc(edit, sc, scsegs, diff, n0, n0v, %l1), nopresc(edit, sc, scsegs, diff, n0, n0v)
  presc(edit: ptr, sc: ptr, scsegs: i64, diff: i64, n0: ptr, n0v: i64, level: i64):
    %ru = add i64 diff, 63
    %ru2 = and i64 %ru, -64
    %keylen = lshr i64 %ru2, 6
    %bytes = mul i64 %keylen, 8
    %size = add i64 %bytes, 24
    %s0 = call ptr kla_kzalloc(%size)
    %s0v = call i64 kla_ptrval(%s0)
    %z = icmp.eq i64 %s0v, 0
    condbr %z, fail(), presc2(edit, sc, scsegs, diff, n0, n0v, %keylen, %s0, %s0v)
  presc2(edit: ptr, sc: ptr, scsegs: i64, diff: i64, n0: ptr, n0v: i64, keylen: i64, s0: ptr, s0v: i64):
    %tag = or i64 s0v, 3
    call void kla_edit_st(edit, 72, %tag)
    call void kla_edit_st(edit, 264, %tag)
    %bp = load i64, %sc
    store i64 %s0, %bp
    %sp = gep i8 %sc, 8
    %ps = load i32, %sp
    %tp = gep i8 %s0, 8
    store i32 %tp, %ps
