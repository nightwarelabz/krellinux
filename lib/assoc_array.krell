fn assoc_array_delete(ptr, ptr, ptr) -> ptr {
  entry(array: ptr, ops: ptr, key: ptr):
    %edit = call ptr kla_kzalloc(328)
    %ev = call i64 kla_ptrval(%edit)
    %z = icmp.eq i64 %ev, 0
    condbr %z, enomem0(), setup(array, ops, key, %edit)
  setup(array: ptr, ops: ptr, key: ptr, edit: ptr):
    %av = call i64 kla_ptrval(array)
    call void kla_edit_st(edit, 16, %av)
    %opv = call i64 kla_ptrval(ops)
    call void kla_edit_st(edit, 24, %opv)
    call void kla_edit_st(edit, 248, -1)
    %onode = alloca 8, 8
    %olevel = alloca 8, 8
    %oslot = alloca 8, 8
    %osc = alloca 8, 8
    %osclevel = alloca 8, 8
    %oscseg = alloca 8, 8
    %odiss = alloca 8, 8
    %st = call i64 kla_walk(array, ops, key, %onode, %olevel, %oslot, %osc, %osclevel, %oscseg, %odiss)
    %eq = icmp.eq i64 %st, 1
    condbr %eq, scan(array, ops, key, edit, %onode, 0), notfound(edit)
  scan(array: ptr, ops: ptr, key: ptr, edit: ptr, onode: ptr, slot: i64):
    %lt = icmp.slt i64 slot, 16
    condbr %lt, sbody(array, ops, key, edit, onode, slot), notfound(edit)
  sbody(array: ptr, ops: ptr, key: ptr, edit: ptr, onode: ptr, slot: i64):
    %node = load ptr, %onode
    %off = mul i64 slot, 8
    %addr = gep i8 %node, %off
    %pp = gep i8 %addr, 16
    %ptr = load i64, %pp
    %nz = icmp.ne i64 %ptr, 0
    condbr %nz, schk(array, ops, key, edit, onode, slot, %node, %ptr), snext(array, ops, key, edit, onode, slot)
  schk(array: ptr, ops: ptr, key: ptr, edit: ptr, onode: ptr, slot: i64, node: ptr, ptr: i64):
    %leaf = and i64 ptr, 1
    %z = icmp.eq i64 %leaf, 0
    condbr %z, scmp(array, ops, key, edit, onode, slot, node, ptr), snext(array, ops, key, edit, onode, slot)
  scmp(array: ptr, ops: ptr, key: ptr, edit: ptr, onode: ptr, slot: i64, node: ptr, ptr: i64):
    %base = and i64 ptr, -2
    %leaf = call ptr kla_fromval(%base)
    %r = call i32 kla_call_cmpobj(ops, 16, %leaf, key)
    %nz = icmp.ne i32 %r, 0
    condbr %nz, found(array, edit, node, slot), snext(array, ops, key, edit, onode, slot)
  snext(array: ptr, ops: ptr, key: ptr, edit: ptr, onode: ptr, slot: i64):
    %s1 = add i64 slot, 1
    br scan(array, ops, key, edit, onode, %s1)
  found(array: ptr, edit: ptr, node: ptr, slot: i64):
    %np = gep i8 array, 8
    %nr = load i64, %np
    %z = icmp.eq i64 %nr, 0
    condbr %z, bug(), fgo(array, edit, node, slot, %nr)
  fgo(array: ptr, edit: ptr, node: ptr, slot: i64, nr: i64):
    %off = mul i64 slot, 8
    %addr = gep i8 node, %off
    %pp = gep i8 %addr, 16
    %dead = load i64, %pp
    call void kla_edit_st(edit, 56, %dead)
    %av2 = call i64 kla_ptrval(%pp)
    call void kla_edit_st(edit, 256, %av2)
    call void kla_edit_st(edit, 264, 0)
    %nv = call i64 kla_ptrval(node)
    call void kla_edit_st(edit, 240, %nv)
    %one = icmp.eq i64 nr, 1
    condbr %one, lastone(array, edit), collapsechk(array, edit, node)
  lastone(array: ptr, edit: ptr):
    %av = call i64 kla_ptrval(array)
    call void kla_edit_st(edit, 272, %av)
    call void kla_edit_st(edit, 280, 0)
    call void kla_edit_st(edit, 240, 0)
    %root = load i64, array
    call void kla_edit_st(edit, 96, %root)
    ret edit
  collapsechk(array: ptr, edit: ptr, node: ptr):
    %nrp = gep i8 node, 144
    %br = load i64, %nrp
    %le = icmp.ule i64 %br, 17
    condbr %le, meta_scan(array, edit, node, 0, 0), retedit(edit)
  meta_scan(array: ptr, edit: ptr, node: ptr, i: i64, has_meta: i64):
    %lt = icmp.slt i64 i, 16
    condbr %lt, ms_body(array, edit, node, i, has_meta), collapse_up(array, edit, node, node, has_meta)
  ms_body(array: ptr, edit: ptr, node: ptr, i: i64, has_meta: i64):
    %off = mul i64 i, 8
    %addr = gep i8 node, %off
    %pp = gep i8 %addr, 16
    %ptr = load i64, %pp
    %meta = and i64 %ptr, 1
    %nz = icmp.ne i64 %meta, 0
    condbr %nz, ms_next(array, edit, node, i, 1), ms_next(array, edit, node, i, has_meta)
  ms_next(array: ptr, edit: ptr, node: ptr, i: i64, has_meta: i64):
    %i1 = add i64 i, 1
    br meta_scan(array, edit, node, %i1, has_meta)
  collapse_up(array: ptr, edit: ptr, node: ptr, parent: ptr, has_meta: i64):
    %bp = load i64, %parent
    %z = icmp.eq i64 %bp, 0
    condbr %z, do_collapse(array, edit, node, parent, has_meta), cu_chk(array, edit, node, parent, has_meta, %bp)
  cu_chk(array: ptr, edit: ptr, node: ptr, parent: ptr, has_meta: i64, bp: i64):
    %sc = and i64 bp, 2
    %nz = icmp.ne i64 %sc, 0
    condbr %nz, cu_sc(array, edit, node, parent, has_meta, bp), cu_gp(array, edit, node, parent, has_meta, bp)
  cu_sc(array: ptr, edit: ptr, node: ptr, parent: ptr, has_meta: i64, bp: i64):
    %base = and i64 bp, -4
    %sc = call ptr kla_fromval(%base)
    %nbp = load i64, %sc
    %z = icmp.eq i64 %nbp, 0
    condbr %z, do_collapse(array, edit, node, parent, has_meta), cu_gp(array, edit, node, parent, has_meta, %nbp)
  cu_gp(array: ptr, edit: ptr, node: ptr, parent: ptr, has_meta: i64, bp: i64):
    %base = and i64 bp, -4
    %gp = call ptr kla_fromval(%base)
    %nrp = gep i8 %gp, 144
    %br = load i64, %nrp
    %le = icmp.ule i64 %br, 17
    condbr %le, collapse_up(array, edit, node, %gp, has_meta), do_collapse(array, edit, node, parent, has_meta)
  do_collapse(array: ptr, edit: ptr, node: ptr, parent: ptr, has_meta: i64):
    %nz = icmp.ne i64 has_meta, 0
    condbr %nz, collapse(array, edit, parent), dc_chk(array, edit, node, parent)
  dc_chk(array: ptr, edit: ptr, node: ptr, parent: ptr):
    %pv = call i64 kla_ptrval(parent)
    %nv0 = call i64 kla_ptrval(node)
    %diff = icmp.ne i64 %pv, %nv0
    condbr %diff, collapse(array, edit, parent), retedit(edit)
  collapse(array: ptr, edit: ptr, node: ptr):
    %n0 = call ptr kla_kzalloc(152)
    %n0v = call i64 kla_ptrval(%n0)
    %z = icmp.eq i64 %n0v, 0
    condbr %z, enomem(edit), cgo(array, edit, node, %n0, %n0v)
  cgo(array: ptr, edit: ptr, node: ptr, n0: ptr, n0v: i64):
    %ctx = call ptr kla_kzalloc(24)
    %cv = call i64 kla_ptrval(%ctx)
    %z0 = icmp.eq i64 %cv, 0
    condbr %z0, ctxfail(edit, n0), cbody(array, edit, node, n0, n0v, %ctx)
  ctxfail(edit: ptr, n0: ptr):
    call void kfree(n0)
    br enomem(edit)
  cbody(array: ptr, edit: ptr, node: ptr, n0: ptr, n0v: i64, ctx: ptr):
    %tag = or i64 n0v, 1
    call void kla_edit_st(edit, 64, %tag)
    %bp = load i64, node
    store i64 %n0, %bp
    %sp = gep i8 node, 8
    %ps = load i8, %sp
    %tp = gep i8 n0, 8
    store i8 %tp, %ps
    %nrp = gep i8 node, 144
    %br = load i64, %nrp
    %tn = gep i8 n0, 144
    store i64 %tn, %br
    call void kla_edit_st(edit, 240, n0v)
    store ptr ctx, %n0
    %dead = call i64 kla_edit_ld(edit, 56)
    %leaf = and i64 %dead, -2
    %cp = gep i8 %ctx, 8
    store i64 %cp, %leaf
    %csp = gep i8 %ctx, 16
    store i32 %csp, 0
    %nv = call i64 kla_ptrval(node)
    %ntag = or i64 %nv, 1
    %iter = funcptr kla_delete_collapse_iterator
    %r = call i32 kla_subtree_iterate(%ntag, %bp, %iter, %ctx)
    %slot32 = load i32, %csp
    call void kfree(ctx)
    %slot = sext i64 %slot32
    %want = sub i64 %br, 1
    %ne = icmp.ne i64 %slot, %want
    condbr %ne, bug(), cset(array, edit, node, n0, %tag)
  cset(array: ptr, edit: ptr, node: ptr, n0: ptr, tag: i64):
    %bp = load i64, node
    %z = icmp.eq i64 %bp, 0
    condbr %z, croot(array, edit, tag), cchk(array, edit, node, tag, %bp)
  croot(array: ptr, edit: ptr, tag: i64):
    %av = call i64 kla_ptrval(array)
    call void kla_edit_st(edit, 272, %av)
    br cfin(array, edit, node, tag)
  cchk(array: ptr, edit: ptr, node: ptr, tag: i64, bp: i64):
    %leaf = and i64 bp, 1
    %z = icmp.eq i64 %leaf, 0
    condbr %z, bug(), cchk2(array, edit, node, tag, bp)
  cchk2(array: ptr, edit: ptr, node: ptr, tag: i64, bp: i64):
    %nd = and i64 bp, 2
    %z = icmp.eq i64 %nd, 0
    condbr %z, cnode(array, edit, node, tag, bp), csc(array, edit, node, tag, bp)
  cnode(array: ptr, edit: ptr, node: ptr, tag: i64, bp: i64):
    %base = and i64 bp, -4
    %par = call ptr kla_fromval(%base)
    %sp = gep i8 node, 8
    %ps = load i8, %sp
    %ps64 = zext i64 %ps
    %off = mul i64 %ps64, 8
    %addr = gep i8 %par, %off
    %pp = gep i8 %addr, 16
    %av = call i64 kla_ptrval(%pp)
    call void kla_edit_st(edit, 272, %av)
    br cfin(array, edit, node, tag)
  csc(array: ptr, edit: ptr, node: ptr, tag: i64, bp: i64):
    %base = and i64 bp, -4
    %sc = call ptr kla_fromval(%base)
    %pp = gep i8 %sc, 16
    %av = call i64 kla_ptrval(%pp)
    call void kla_edit_st(edit, 272, %av)
    br cfin(array, edit, node, tag)
  cfin(array: ptr, edit: ptr, node: ptr, tag: i64):
