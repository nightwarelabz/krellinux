  kf_done(edit: ptr, ops: ptr, key: ptr, node: ptr, n0: ptr, n1: ptr, keylen: i64, s0: ptr, newlevel: i64):
    %cm = and i64 newlevel, 63
    %nz = icmp.ne i64 %cm, 0
    condbr %nz, blank(edit, ops, key, node, n0, n1, keylen, s0, newlevel), regen(edit, ops, key, node, n0, n1, newlevel)
  blank(edit: ptr, ops: ptr, key: ptr, node: ptr, n0: ptr, n1: ptr, keylen: i64, s0: ptr, newlevel: i64):
    %cm = and i64 newlevel, 63
    %blank = shl i64 -1, %cm
