; SPDX-License-Identifier: GPL-2.0
; lib/assoc_array.c converted to Krell (Phase 1 batch 7).
;
; The associative array is the C algorithm operation for
; operation.  Layout (x86_64): struct assoc_array { root
; @0, nr_leaves_on_tree @8 }; struct assoc_array_ops {
; get_key_chunk @0, get_object_key_chunk @8,
; compare_object @16, diff_objects @24, free_object @32 };
; struct assoc_array_node { back_pointer @0, parent_slot
; (u8) @8, slots[16] @16, nr_leaves_on_branch @144 } (152
; bytes); struct assoc_array_shortcut { back_pointer @0,
; parent_slot (int) @8, skip_to_level (int) @12, next_node
; @16, index_key[] @24 }; struct assoc_array_edit is 328
; bytes with fields as noted at each use.
;
; Internal pointers are tagged in the low two bits (bit0:
; meta; bit1: shortcut subtype) and are carried here as
; i64 bit patterns, materialized as pointers only for
; dereference - the same values C manipulates.
;
; READ_ONCE() sites use volatile loads (loadv); the
; smp_wmb() calls in assoc_array_apply_edit use
; fence.release, which is what smp_wmb amounts to on
; x86_64 (a compiler barrier, no instruction).
;
; Allocations go to __kmalloc_noprof, the entry point the
; kzalloc/kmalloc inlines reduce to for runtime sizes:
; kzalloc sites pass GFP_KERNEL|__GFP_ZERO (0xDC0), the
; one plain kmalloc site in assoc_array_gc passes
; GFP_KERNEL (0xCC0).
;
; BUG_ON()/BUG() traps: where C asserts an invariant, the
; Krell form calls panic() and does not return, preserving
; the observable contract.
;
; The walk result: C passes a 48-byte stack struct to
; assoc_array_walk; here the seven result fields travel
; through seven separate 8-byte slots owned by the caller
; (a contiguous multi-word stack buffer cannot be an
; alloca here).  The delete collapse context (24 bytes,
; passed by pointer to the collapse iterator) cannot
; live in module data either (Krell data blobs are
; constants, emitted in .rodata), so it is a small
; kzalloc for the duration of the collapse walk, freed
; before the edit is returned; its allocation failure
; takes the same -ENOMEM path as the replacement node's.

extern __kmalloc_noprof(i64, i64) -> ptr
extern kfree(ptr) -> void
extern memcpy(ptr, ptr, i64) -> ptr
extern call_rcu(ptr, ptr) -> void
extern panic(ptr) -> void

sig kla_sig_chunk(ptr, i32) -> i64
sig kla_sig_cmpobj(ptr, ptr) -> i32
sig kla_sig_diff(ptr, ptr) -> i32
sig kla_sig_free(ptr) -> void
sig kla_sig_iter(ptr, ptr) -> i32
sig kla_sig_gciter(ptr, ptr) -> i32

fn kla_call_chunk(ptr, i64, ptr, i32) -> i64 {
  entry(base: ptr, off: i64, a: ptr, level: i32):
    %pp = gep i8 base, off
    %fp = load ptr, %pp
    %r = calli i64 kla_sig_chunk %fp(a, level)
    ret %r
}

fn kla_call_cmpobj(ptr, i64, ptr, ptr) -> i32 {
  entry(base: ptr, off: i64, obj: ptr, key: ptr):
    %pp = gep i8 base, off
    %fp = load ptr, %pp
    %r = calli i32 kla_sig_cmpobj %fp(obj, key)
    %b = trunc i8 %r
    %n = zext i32 %b
    ret %n
}

fn kla_call_diff(ptr, i64, ptr, ptr) -> i32 {
  entry(base: ptr, off: i64, obj: ptr, key: ptr):
    %pp = gep i8 base, off
    %fp = load ptr, %pp
    %r = calli i32 kla_sig_diff %fp(obj, key)
    ret %r
}

fn kla_call_free(ptr, i64, ptr) -> void {
  entry(base: ptr, off: i64, obj: ptr):
    %pp = gep i8 base, off
    %fp = load ptr, %pp
    calli void kla_sig_free %fp(obj)
    ret
}

fn kla_call_iter(ptr, ptr, ptr) -> i32 {
  entry(slot: ptr, leaf: ptr, data: ptr):
    %fp = load ptr, slot
    %r = calli i32 kla_sig_iter %fp(leaf, data)
    ret %r
}

fn kla_call_gciter(ptr, ptr, ptr) -> i32 {
  entry(slot: ptr, leaf: ptr, data: ptr):
    %fp = load ptr, slot
    %r = calli i32 kla_sig_gciter %fp(leaf, data)
    %b = trunc i8 %r
    %n = zext i32 %b
    ret %n
}

data kla_bugmsg: i8 = { 107, 114, 101, 108, 108, 105, 110, 117, 120, 58, 32, 97, 115, 115, 111, 99, 95, 97, 114, 114, 97, 121, 32, 105, 110, 118, 97, 114, 105, 97, 110, 116, 32, 118, 105, 111, 108, 97, 116, 101, 100, 10, 0 }

fn kla_ptrval(ptr) -> i64 {
  entry(p: ptr):
    %slot = alloca 8, 8
    store i64 %slot, 0
    store ptr %slot, p
    %v = load i64, %slot
    ret %v
}

fn kla_fromval(i64) -> ptr {
  entry(v: i64):
    %slot = alloca 8, 8
    store i64 %slot, v
    %p = load ptr, %slot
    ret %p
}

fn kla_null() -> ptr {
  entry():
    %p = call ptr kla_fromval(0)
    ret %p
}

fn kla_bug() -> void {
  entry():
    %msg = dataptr 0
    call void panic(%msg)
    br hang()
  hang():
    br hang()
}

fn kla_kzalloc(i64) -> ptr {
  entry(size: i64):
    %p = call ptr __kmalloc_noprof(size, 3424)
    ret %p
}

fn kla_subtree_iterate(i64, i64, ptr, ptr) -> i32 {
  entry(root: i64, stop: i64, iter: ptr, data: ptr):
    %slot = alloca 8, 8
    store ptr %slot, iter
    br begin_node(root, stop, %slot, data)
  begin_node(cursor: i64, stop: i64, iter: ptr, data: ptr):
    %sc = and i64 cursor, 2
    %nz = icmp.ne i64 %sc, 0
    condbr %nz, via_sc(cursor, stop, iter, data), to_node(cursor, stop, iter, data)
  via_sc(cursor: i64, stop: i64, iter: ptr, data: ptr):
    %base = and i64 cursor, -4
    %sc = call ptr kla_fromval(%base)
    %pp = gep i8 %sc, 16
    %nn = loadv i64, %pp
    br to_node(%nn, stop, iter, data)
  to_node(cursor: i64, stop: i64, iter: ptr, data: ptr):
    %base = and i64 cursor, -4
    %node = call ptr kla_fromval(%base)
    br pass1(cursor, stop, iter, data, %node, 0, 0)
  pass1(cursor: i64, stop: i64, iter: ptr, data: ptr, node: ptr, slot: i64, has_meta: i64):
    %lt = icmp.slt i64 slot, 16
    condbr %lt, p1_body(cursor, stop, iter, data, node, slot, has_meta), p1_done(cursor, stop, iter, data, node, has_meta)
  p1_body(cursor: i64, stop: i64, iter: ptr, data: ptr, node: ptr, slot: i64, has_meta: i64):
    %off = mul i64 slot, 8
    %addr = gep i8 node, %off
    %pp = gep i8 %addr, 16
    %ptr = loadv i64, %pp
    %hm = or i64 has_meta, %ptr
    %nz = icmp.ne i64 %ptr, 0
    condbr %nz, p1_chk(cursor, stop, iter, data, node, slot, %hm, %ptr), p1_next(cursor, stop, iter, data, node, slot, %hm)
  p1_chk(cursor: i64, stop: i64, iter: ptr, data: ptr, node: ptr, slot: i64, has_meta: i64, ptr: i64):
    %leaf = and i64 ptr, 1
    %z = icmp.eq i64 %leaf, 0
    condbr %z, p1_call(cursor, stop, iter, data, node, slot, has_meta, ptr), p1_next(cursor, stop, iter, data, node, slot, has_meta)
  p1_call(cursor: i64, stop: i64, iter: ptr, data: ptr, node: ptr, slot: i64, has_meta: i64, ptr: i64):
    %base = and i64 ptr, -2
    %leaf = call ptr kla_fromval(%base)
    %ret = call i32 kla_call_iter(%iter, %leaf, data)
    %nz = icmp.ne i32 %ret, 0
    condbr %nz, retblk(%ret), p1_next(cursor, stop, iter, data, node, slot, has_meta)
  p1_next(cursor: i64, stop: i64, iter: ptr, data: ptr, node: ptr, slot: i64, has_meta: i64):
    %s1 = add i64 slot, 1
    br pass1(cursor, stop, iter, data, node, %s1, has_meta)
  p1_done(cursor: i64, stop: i64, iter: ptr, data: ptr, node: ptr, has_meta: i64):
    %m = and i64 has_meta, 1
    %z = icmp.eq i64 %m, 0
    condbr %z, finished(stop, iter, data, node), pass2(cursor, stop, iter, data, 0)
  pass2(cursor: i64, stop: i64, iter: ptr, data: ptr, slot: i64):
    %base = and i64 cursor, -4
    %node = call ptr kla_fromval(%base)
    br p2_loop(cursor, stop, iter, data, %node, slot)
  p2_loop(cursor: i64, stop: i64, iter: ptr, data: ptr, node: ptr, slot: i64):
    %lt = icmp.slt i64 slot, 16
    condbr %lt, p2_body(cursor, stop, iter, data, node, slot), finished(stop, iter, data, node)
  p2_body(cursor: i64, stop: i64, iter: ptr, data: ptr, node: ptr, slot: i64):
    %off = mul i64 slot, 8
    %addr = gep i8 node, %off
    %pp = gep i8 %addr, 16
    %ptr = loadv i64, %pp
    %meta = and i64 %ptr, 1
    %nz = icmp.ne i64 %meta, 0
    condbr %nz, begin_node(%ptr, stop, iter, data), p2_next(cursor, stop, iter, data, node, slot)
  p2_next(cursor: i64, stop: i64, iter: ptr, data: ptr, node: ptr, slot: i64):
    %s1 = add i64 slot, 1
    br p2_loop(cursor, stop, iter, data, node, %s1)
  finished(stop: i64, iter: ptr, data: ptr, node: ptr):
    %parent = loadv i64, node
    %sp = gep i8 node, 8
    %slot8 = load i8, %sp
    %slot = zext i64 %slot8
    %eq = icmp.eq i64 %parent, stop
    condbr %eq, retzero(), f_chk(%parent, %slot, stop, iter, data)
  f_chk(parent: i64, slot: i64, stop: i64, iter: ptr, data: ptr):
    %sc = and i64 parent, 2
    %nz = icmp.ne i64 %sc, 0
    condbr %nz, f_sc(parent, stop, iter, data), ascend(parent, slot, stop, iter, data)
  f_sc(parent: i64, stop: i64, iter: ptr, data: ptr):
    %base = and i64 parent, -4
    %sc = call ptr kla_fromval(%base)
    %bp = loadv i64, %sc
    %sp = gep i8 %sc, 8
    %slot32 = load i32, %sp
    %slot = sext i64 %slot32
    %eq = icmp.eq i64 %bp, stop
    condbr %eq, retzero(), ascend(%bp, %slot, stop, iter, data)
  ascend(parent: i64, slot: i64, stop: i64, iter: ptr, data: ptr):
    %s1 = add i64 slot, 1
    br pass2(parent, stop, iter, data, %s1)
  retzero():
    ret 0
  retblk(r: i32):
    ret r
}

fn assoc_array_iterate(ptr, ptr, ptr) -> i32 {
  entry(array: ptr, iter: ptr, data: ptr):
    %root = loadv i64, array
    %z = icmp.eq i64 %root, 0
    condbr %z, retzero(), go(%root, iter, data)
  go(root: i64, iter: ptr, data: ptr):
    %r = call i32 kla_subtree_iterate(root, 0, iter, data)
    ret %r
  retzero():
    ret 0
}

fn kla_walk(ptr, ptr, ptr, ptr, ptr, ptr, ptr, ptr, ptr, ptr) -> i64 {
  entry(array: ptr, ops: ptr, key: ptr, onode: ptr, olevel: ptr, oslot: ptr, osc: ptr, osclevel: ptr, oscseg: ptr, odiss: ptr):
    %root = loadv i64, array
    %fp = load ptr, ops
    %z = icmp.eq i64 %root, 0
    condbr %z, empty(), jumped(array, ops, key, onode, olevel, oslot, osc, osclevel, oscseg, odiss, %root, 0, %fp)
  jumped(array: ptr, ops: ptr, key: ptr, onode: ptr, olevel: ptr, oslot: ptr, osc: ptr, osclevel: ptr, oscseg: ptr, odiss: ptr, cursor: i64, level: i64, fp: ptr):
    %lv32 = trunc i32 level
    %segs = call i64 kla_call_chunk(ops, 0, key, %lv32)
    %sc = and i64 cursor, 2
    %nz = icmp.ne i64 %sc, 0
    condbr %nz, follow_sc(array, ops, key, onode, olevel, oslot, osc, osclevel, oscseg, odiss, cursor, level, %segs, fp), consider(array, ops, key, onode, olevel, oslot, osc, osclevel, oscseg, odiss, cursor, level, %segs, fp)
  consider(array: ptr, ops: ptr, key: ptr, onode: ptr, olevel: ptr, oslot: ptr, osc: ptr, osclevel: ptr, oscseg: ptr, odiss: ptr, cursor: i64, level: i64, segs: i64, fp: ptr):
    %base = and i64 cursor, -4
    %node = call ptr kla_fromval(%base)
    %sh = and i64 level, 63
    %seg = lshr i64 segs, %sh
    %slot = and i64 %seg, 15
    %off = mul i64 %slot, 8
    %addr = gep i8 %node, %off
    %pp = gep i8 %addr, 16
    %ptr = loadv i64, %pp
    %meta = and i64 %ptr, 1
    %z = icmp.eq i64 %meta, 0
    condbr %z, terminal(onode, olevel, oslot, %node, level, %slot), meta(array, ops, key, onode, olevel, oslot, osc, osclevel, oscseg, odiss, cursor, level, segs, %ptr, fp)
  terminal(onode: ptr, olevel: ptr, oslot: ptr, node: ptr, level: i64, slot: i64):
    store ptr %onode, node
    store i64 %olevel, level
    store i64 %oslot, slot
    ret 1
  meta(array: ptr, ops: ptr, key: ptr, onode: ptr, olevel: ptr, oslot: ptr, osc: ptr, osclevel: ptr, oscseg: ptr, odiss: ptr, cursor: i64, level: i64, segs: i64, ptr: i64, fp: ptr):
    %isnode = and i64 ptr, 2
    %z = icmp.eq i64 %isnode, 0
    condbr %z, downnode(array, ops, key, onode, olevel, oslot, osc, osclevel, oscseg, odiss, level, segs, ptr, fp), follow_sc(array, ops, key, onode, olevel, oslot, osc, osclevel, oscseg, odiss, ptr, level, segs, fp)
  downnode(array: ptr, ops: ptr, key: ptr, onode: ptr, olevel: ptr, oslot: ptr, osc: ptr, osclevel: ptr, oscseg: ptr, odiss: ptr, level: i64, segs: i64, ptr: i64, fp: ptr):
    %l1 = add i64 level, 4
    %cm = and i64 %l1, 63
    %nz = icmp.ne i64 %cm, 0
    condbr %nz, consider(array, ops, key, onode, olevel, oslot, osc, osclevel, oscseg, odiss, ptr, %l1, segs, fp), jumped(array, ops, key, onode, olevel, oslot, osc, osclevel, oscseg, odiss, ptr, %l1, fp)
  follow_sc(array: ptr, ops: ptr, key: ptr, onode: ptr, olevel: ptr, oslot: ptr, osc: ptr, osclevel: ptr, oscseg: ptr, odiss: ptr, cursor: i64, level: i64, segs: i64, fp: ptr):
    %base = and i64 cursor, -4
    %sc = call ptr kla_fromval(%base)
    %spp = gep i8 %sc, 12
    %skip32 = load i32, %spp
    %skip = sext i64 %skip32
    %sclevel = add i64 level, 4
    %gt = icmp.sgt i64 %sclevel, %skip
    condbr %gt, bug(), sc_loop(array, ops, key, onode, olevel, oslot, osc, osclevel, oscseg, odiss, cursor, %sc, %skip, level, %sclevel, segs, fp)
  sc_loop(array: ptr, ops: ptr, key: ptr, onode: ptr, olevel: ptr, oslot: ptr, osc: ptr, osclevel: ptr, oscseg: ptr, odiss: ptr, cursor: i64, sc: ptr, skip: i64, level: i64, sclevel: i64, segs: i64, fp: ptr):
    %cm = and i64 sclevel, 63
    %z = icmp.eq i64 %cm, 0
    condbr %z, refetch(array, ops, key, onode, olevel, oslot, osc, osclevel, oscseg, odiss, cursor, sc, skip, level, sclevel, fp), have(array, ops, key, onode, olevel, oslot, osc, osclevel, oscseg, odiss, cursor, sc, skip, level, sclevel, segs, fp)
  refetch(array: ptr, ops: ptr, key: ptr, onode: ptr, olevel: ptr, oslot: ptr, osc: ptr, osclevel: ptr, oscseg: ptr, odiss: ptr, cursor: i64, sc: ptr, skip: i64, level: i64, sclevel: i64, fp: ptr):
    %lv32 = trunc i32 sclevel
    %segs = call i64 kla_call_chunk(ops, 0, key, %lv32)
    br have(array, ops, key, onode, olevel, oslot, osc, osclevel, oscseg, odiss, cursor, sc, skip, level, sclevel, %segs, fp)
  have(array: ptr, ops: ptr, key: ptr, onode: ptr, olevel: ptr, oslot: ptr, osc: ptr, osclevel: ptr, oscseg: ptr, odiss: ptr, cursor: i64, sc: ptr, skip: i64, level: i64, sclevel: i64, segs: i64, fp: ptr):
    %idx = lshr i64 sclevel, 6
    %off = mul i64 %idx, 8
    %addr = gep i8 sc, %off
    %pp = gep i8 %addr, 24
    %scsegs = load i64, %pp
    %diss = xor i64 segs, %scsegs
    %rd = and i64 sclevel, -64
    %lim = add i64 %rd, 64
    %lt = icmp.slt i64 skip, %lim
    condbr %lt, trim(array, ops, key, onode, olevel, oslot, osc, osclevel, oscseg, odiss, cursor, sc, skip, level, sclevel, segs, %scsegs, %diss, fp), notrim(array, ops, key, onode, olevel, oslot, osc, osclevel, oscseg, odiss, cursor, sc, skip, level, sclevel, segs, %scsegs, %diss, fp)
  trim(array: ptr, ops: ptr, key: ptr, onode: ptr, olevel: ptr, oslot: ptr, osc: ptr, osclevel: ptr, oscseg: ptr, odiss: ptr, cursor: i64, sc: ptr, skip: i64, level: i64, sclevel: i64, segs: i64, scsegs: i64, diss: i64, fp: ptr):
    %shift = and i64 skip, 63
    %pow = shl i64 1, %shift
    %keep = sub i64 %pow, 1
    %diss2 = and i64 diss, %keep
    br sc_chk(array, ops, key, onode, olevel, oslot, osc, osclevel, oscseg, odiss, cursor, sc, skip, level, sclevel, segs, scsegs, %diss2, skip, fp)
  notrim(array: ptr, ops: ptr, key: ptr, onode: ptr, olevel: ptr, oslot: ptr, osc: ptr, osclevel: ptr, oscseg: ptr, odiss: ptr, cursor: i64, sc: ptr, skip: i64, level: i64, sclevel: i64, segs: i64, scsegs: i64, diss: i64, fp: ptr):
    %n1 = add i64 sclevel, 64
    %next = and i64 %n1, -64
    br sc_chk(array, ops, key, onode, olevel, oslot, osc, osclevel, oscseg, odiss, cursor, sc, skip, level, sclevel, segs, scsegs, diss, %next, fp)
  sc_chk(array: ptr, ops: ptr, key: ptr, onode: ptr, olevel: ptr, oslot: ptr, osc: ptr, osclevel: ptr, oscseg: ptr, odiss: ptr, cursor: i64, sc: ptr, skip: i64, level: i64, sclevel: i64, segs: i64, scsegs: i64, diss: i64, next: i64, fp: ptr):
    %nz = icmp.ne i64 diss, 0
    condbr %nz, wrong(osc, olevel, osclevel, oscseg, odiss, sc, level, sclevel, scsegs, diss), sc_next(array, ops, key, onode, olevel, oslot, osc, osclevel, oscseg, odiss, cursor, sc, skip, level, segs, next, fp)
  wrong(osc: ptr, olevel: ptr, osclevel: ptr, oscseg: ptr, odiss: ptr, sc: ptr, level: i64, sclevel: i64, scsegs: i64, diss: i64):
    store ptr %osc, sc
    store i64 %olevel, level
    store i64 %osclevel, sclevel
    store i64 %oscseg, scsegs
    store i64 %odiss, diss
    ret 2
  sc_next(array: ptr, ops: ptr, key: ptr, onode: ptr, olevel: ptr, oslot: ptr, osc: ptr, osclevel: ptr, oscseg: ptr, odiss: ptr, cursor: i64, sc: ptr, skip: i64, level: i64, segs: i64, sclevel: i64, fp: ptr):
    %lt = icmp.slt i64 sclevel, skip
    condbr %lt, sc_loop(array, ops, key, onode, olevel, oslot, osc, osclevel, oscseg, odiss, cursor, sc, skip, level, sclevel, segs, fp), sc_done(array, ops, key, onode, olevel, oslot, osc, osclevel, oscseg, odiss, sc, level, segs, sclevel, fp)
  sc_done(array: ptr, ops: ptr, key: ptr, onode: ptr, olevel: ptr, oslot: ptr, osc: ptr, osclevel: ptr, oscseg: ptr, odiss: ptr, sc: ptr, level: i64, segs: i64, sclevel: i64, fp: ptr):
    %pp = gep i8 sc, 16
    %nn = loadv i64, %pp
    %x = xor i64 level, sclevel
    %mask = and i64 %x, -64
    %nz = icmp.ne i64 %mask, 0
    condbr %nz, jumped(array, ops, key, onode, olevel, oslot, osc, osclevel, oscseg, odiss, %nn, sclevel, fp), consider(array, ops, key, onode, olevel, oslot, osc, osclevel, oscseg, odiss, %nn, sclevel, segs, fp)
  empty():
    ret 0
  bug():
    call void kla_bug()
    ret 0
}

fn assoc_array_find(ptr, ptr, ptr) -> ptr {
  entry(array: ptr, ops: ptr, key: ptr):
    %onode = alloca 8, 8
    %olevel = alloca 8, 8
    %oslot = alloca 8, 8
    %osc = alloca 8, 8
    %osclevel = alloca 8, 8
    %oscseg = alloca 8, 8
    %odiss = alloca 8, 8
    %st = call i64 kla_walk(array, ops, key, %onode, %olevel, %oslot, %osc, %osclevel, %oscseg, %odiss)
    %eq = icmp.eq i64 %st, 1
    condbr %eq, scan(ops, key, %onode, 0), nullret()
  scan(ops: ptr, key: ptr, onode: ptr, slot: i64):
    %lt = icmp.slt i64 slot, 16
    condbr %lt, body(ops, key, onode, slot), nullret()
  body(ops: ptr, key: ptr, onode: ptr, slot: i64):
    %node = load ptr, %onode
    %off = mul i64 slot, 8
    %addr = gep i8 %node, %off
    %pp = gep i8 %addr, 16
    %ptr = loadv i64, %pp
    %nz = icmp.ne i64 %ptr, 0
    condbr %nz, chk(ops, key, onode, slot, %ptr), next(ops, key, onode, slot)
  chk(ops: ptr, key: ptr, onode: ptr, slot: i64, ptr: i64):
    %leaf = and i64 ptr, 1
    %z = icmp.eq i64 %leaf, 0
    condbr %z, cmp(ops, key, onode, slot, ptr), next(ops, key, onode, slot)
  cmp(ops: ptr, key: ptr, onode: ptr, slot: i64, ptr: i64):
    %base = and i64 ptr, -2
    %leaf = call ptr kla_fromval(%base)
    %r = call i32 kla_call_cmpobj(ops, 16, %leaf, key)
    %nz = icmp.ne i32 %r, 0
    condbr %nz, found(%leaf), next(ops, key, onode, slot)
  next(ops: ptr, key: ptr, onode: ptr, slot: i64):
    %s1 = add i64 slot, 1
    br scan(ops, key, onode, %s1)
  found(leaf: ptr):
    ret leaf
  nullret():
    %null = call ptr kla_null()
    ret %null
}

fn kla_destroy_subtree(i64, ptr) -> void {
  entry(root: i64, ops: ptr):
    %z = icmp.eq i64 root, 0
    condbr %z, done(), start(root, ops)
  start(root: i64, ops: ptr):
    br move_to_meta(root, 0, -1, ops)
  move_to_meta(cursor: i64, parent: i64, slot: i64, ops: ptr):
    %sc = and i64 cursor, 2
    %nz = icmp.ne i64 %sc, 0
    condbr %nz, sc_down(cursor, parent, slot, ops), node_chk(cursor, parent, slot, ops)
  sc_down(cursor: i64, parent: i64, slot: i64, ops: ptr):
    %base = and i64 cursor, -4
    %sc = call ptr kla_fromval(%base)
    %bp = load i64, %sc
    %ne = icmp.ne i64 %bp, parent
    condbr %ne, bug(), sc_chk2(cursor, %sc, slot, ops)
  sc_chk2(cursor: i64, sc: ptr, slot: i64, ops: ptr):
    %m1 = icmp.eq i64 slot, -1
    condbr %m1, sc_go(cursor, sc, ops), sc_chk3(cursor, sc, slot, ops)
  sc_chk3(cursor: i64, sc: ptr, slot: i64, ops: ptr):
    %pp = gep i8 sc, 8
    %ps = load i32, %pp
    %ps64 = sext i64 %ps
    %ne = icmp.ne i64 %ps64, slot
    condbr %ne, bug(), sc_go(cursor, sc, ops)
  sc_go(cursor: i64, sc: ptr, ops: ptr):
    %pp = gep i8 sc, 16
    %nn = load i64, %pp
    %isnode = and i64 %nn, 2
    %nz = icmp.ne i64 %isnode, 0
    condbr %nz, bug(), node_chk(%nn, cursor, -1, ops)
  node_chk(cursor: i64, parent: i64, slot: i64, ops: ptr):
    %base = and i64 cursor, -4
    %node = call ptr kla_fromval(%base)
    %bp = load i64, %node
    %ne = icmp.ne i64 %bp, parent
    condbr %ne, bug(), n_chk2(cursor, parent, slot, ops, %node)
  n_chk2(cursor: i64, parent: i64, slot: i64, ops: ptr, node: ptr):
    %m1 = icmp.eq i64 slot, -1
    condbr %m1, n_go(cursor, parent, node, ops), n_chk3(cursor, parent, slot, ops, node)
  n_chk3(cursor: i64, parent: i64, slot: i64, ops: ptr, node: ptr):
    %pp = gep i8 node, 8
    %ps = load i8, %pp
    %ps64 = zext i64 %ps
    %ne = icmp.ne i64 %ps64, slot
    condbr %ne, bug(), n_go(cursor, parent, node, ops)
  n_go(cursor: i64, parent: i64, node: ptr, ops: ptr):
    br continue_node(cursor, parent, node, 0, ops)
  continue_node(cursor: i64, parent: i64, node: ptr, slot: i64, ops: ptr):
    %lt = icmp.slt i64 slot, 16
    condbr %lt, body(cursor, parent, node, slot, ops), ascend_prep(cursor, node, ops)
  body(cursor: i64, parent: i64, node: ptr, slot: i64, ops: ptr):
    %off = mul i64 slot, 8
    %addr = gep i8 node, %off
    %pp = gep i8 %addr, 16
    %ptr = load i64, %pp
    %z = icmp.eq i64 %ptr, 0
    condbr %z, next(cursor, parent, node, slot, ops), chkmeta(cursor, parent, node, slot, ops, %ptr)
  chkmeta(cursor: i64, parent: i64, node: ptr, slot: i64, ops: ptr, ptr: i64):
    %meta = and i64 ptr, 1
    %nz = icmp.ne i64 %meta, 0
    condbr %nz, move_to_meta(ptr, cursor, slot, ops), freechk(cursor, parent, node, slot, ops, ptr)
  freechk(cursor: i64, parent: i64, node: ptr, slot: i64, ops: ptr, ptr: i64):
    %ov = call i64 kla_ptrval(ops)
    %nz = icmp.ne i64 %ov, 0
    condbr %nz, freeleaf(cursor, parent, node, slot, ops, ptr), next(cursor, parent, node, slot, ops)
  freeleaf(cursor: i64, parent: i64, node: ptr, slot: i64, ops: ptr, ptr: i64):
    %base = and i64 ptr, -2
    %leaf = call ptr kla_fromval(%base)
    call void kla_call_free(ops, 32, %leaf)
    br next(cursor, parent, node, slot, ops)
  next(cursor: i64, parent: i64, node: ptr, slot: i64, ops: ptr):
    %s1 = add i64 slot, 1
    br continue_node(cursor, parent, node, %s1, ops)
  ascend_prep(cursor: i64, node: ptr, ops: ptr):
    %par = load i64, node
    %sp = gep i8 node, 8
    %ps = load i8, %sp
    %slot = zext i64 %ps
    call void kfree(node)
    %z = icmp.eq i64 %par, 0
    condbr %z, done(), ascend(%par, %slot, cursor, ops)
  ascend(parent: i64, slot: i64, cursor: i64, ops: ptr):
    %sc = and i64 parent, 2
    %nz = icmp.ne i64 %sc, 0
    condbr %nz, sc_up(parent, slot, cursor, ops), up_node(parent, slot, ops)
  sc_up(parent: i64, slot: i64, cursor: i64, ops: ptr):
    %base = and i64 parent, -4
    %sc = call ptr kla_fromval(%base)
    %pp = gep i8 %sc, 16
    %nn = load i64, %pp
    %ne = icmp.ne i64 %nn, cursor
    condbr %ne, bug(), sc_up2(parent, %sc, ops)
  sc_up2(parent: i64, sc: ptr, ops: ptr):
    %bp = load i64, %sc
    %sp = gep i8 %sc, 8
    %ps = load i32, %sp
    %slot = sext i64 %ps
    call void kfree(%sc)
    %z = icmp.eq i64 %bp, 0
    condbr %z, done(), sc_up3(%bp, %slot, ops)
  sc_up3(bp: i64, slot: i64, ops: ptr):
    %isnode = and i64 bp, 2
    %nz = icmp.ne i64 %isnode, 0
    condbr %nz, bug(), up_node(bp, slot, ops)
  up_node(parent: i64, slot: i64, ops: ptr):
    %base = and i64 parent, -4
    %node = call ptr kla_fromval(%base)
    %s1 = add i64 slot, 1
    br continue_node(parent, parent, %node, %s1, ops)
  bug():
    call void kla_bug()
    br done()
  done():
    ret
}

fn assoc_array_destroy(ptr, ptr) -> void {
  entry(array: ptr, ops: ptr):
    %root = load i64, array
    call void kla_destroy_subtree(%root, ops)
    %null = call ptr kla_null()
    store ptr %array, %null
    ret
}

; edit field stores: edit is a real pointer; offsets per
; the layout table in the header comment.
fn kla_edit_st(ptr, i64, i64) -> void {
  entry(edit: ptr, off: i64, val: i64):
    %p = gep i8 edit, off
    store i64 %p, val
    ret
}

fn kla_edit_ld(ptr, i64) -> i64 {
  entry(edit: ptr, off: i64):
    %p = gep i8 edit, off
    %v = load i64, %p
    ret %v
}

fn kla_seg_st(ptr, i64, i64) -> void {
  entry(edit: ptr, idx: i64, val: i64):
    %off = add i64 304, idx
    %p = gep i8 edit, %off
    %v = trunc i8 val
    store i8 %p, %v
    ret
}

fn kla_seg_ld(ptr, i64) -> i64 {
  entry(edit: ptr, idx: i64):
    %off = add i64 304, idx
    %p = gep i8 edit, %off
    %v = load i8, %p
    %r = zext i64 %v
    ret %r
}

fn kla_insert_in_empty_tree(ptr) -> i64 {
  entry(edit: ptr):
    %n0 = call ptr kla_kzalloc(152)
    %nv = call i64 kla_ptrval(%n0)
    %z = icmp.eq i64 %nv, 0
    condbr %z, fail(), go(edit, %n0, %nv)
  go(edit: ptr, n0: ptr, n0v: i64):
    %tagged = or i64 n0v, 1
    call void kla_edit_st(edit, 64, %tagged)
    %leafp = gep i8 n0, 16
    %lv = call i64 kla_ptrval(%leafp)
    call void kla_edit_st(edit, 48, %lv)
    call void kla_edit_st(edit, 240, n0v)
    %arr = call i64 kla_edit_ld(edit, 16)
    call void kla_edit_st(edit, 256, %arr)
    call void kla_edit_st(edit, 264, %tagged)
    ret 1
  fail():
    ret 0
}

; The shared node-split tail of
; assoc_array_insert_into_terminal_node.  On entry the
; segment cache in the edit describes the old node's
; leaves (and the new leaf at index 16), new_meta[0] and
; new_meta[1] hold n0/n1, and set[0].to is already set.
fn kla_do_split(ptr, ptr, ptr, ptr, ptr) -> void {
  entry(edit: ptr, ops: ptr, node: ptr, n0: ptr, n1: ptr):
    %nrp = gep i8 node, 144
    %nrv = load i64, %nrp
    %t0 = gep i8 n0, 144
    store i64 %t0, %nrv
    %t1 = gep i8 n1, 144
    store i64 %t1, 0
    br find_i(edit, ops, node, n0, n1, 0)
  find_i(edit: ptr, ops: ptr, node: ptr, n0: ptr, n1: ptr, i: i64):
    %lt = icmp.slt i64 i, 16
    condbr %lt, fi_body(edit, ops, node, n0, n1, i), found(edit, ops, node, n0, n1, i, 17, 255)
  fi_body(edit: ptr, ops: ptr, node: ptr, n0: ptr, n1: ptr, i: i64):
    %s = call i64 kla_seg_ld(edit, i)
    %ff = icmp.eq i64 %s, 255
    condbr %ff, fi_next(edit, ops, node, n0, n1, i), find_j(edit, ops, node, n0, n1, i, %s)
  fi_next(edit: ptr, ops: ptr, node: ptr, n0: ptr, n1: ptr, i: i64):
    %i1 = add i64 i, 1
    br find_i(edit, ops, node, n0, n1, %i1)
  find_j(edit: ptr, ops: ptr, node: ptr, n0: ptr, n1: ptr, i: i64, s: i64):
    %j0 = add i64 i, 1
    br fj_loop(edit, ops, node, n0, n1, i, s, %j0)
  fj_loop(edit: ptr, ops: ptr, node: ptr, n0: ptr, n1: ptr, i: i64, s: i64, j: i64):
    %lt = icmp.slt i64 j, 17
    condbr %lt, fj_body(edit, ops, node, n0, n1, i, s, j), fi_next(edit, ops, node, n0, n1, i)
  fj_body(edit: ptr, ops: ptr, node: ptr, n0: ptr, n1: ptr, i: i64, s: i64, j: i64):
    %sj = call i64 kla_seg_ld(edit, j)
    %eq = icmp.eq i64 %sj, s
    condbr %eq, found(edit, ops, node, n0, n1, i, j, s), fj_next(edit, ops, node, n0, n1, i, s, j)
  fj_next(edit: ptr, ops: ptr, node: ptr, n0: ptr, n1: ptr, i: i64, s: i64, j: i64):
    %j1 = add i64 j, 1
    br fj_loop(edit, ops, node, n0, n1, i, s, %j1)
  found(edit: ptr, ops: ptr, node: ptr, n0: ptr, n1: ptr, i: i64, j: i64, slot: i64):
    %bi = icmp.sge i64 i, 16
    condbr %bi, bug(), found2(edit, ops, node, n0, n1, i, j, slot)
  found2(edit: ptr, ops: ptr, node: ptr, n0: ptr, n1: ptr, i: i64, j: i64, slot: i64):
    %bj = icmp.sge i64 j, 17
    condbr %bj, bug(), found3(edit, ops, node, n0, n1, slot)
  found3(edit: ptr, ops: ptr, node: ptr, n0: ptr, n1: ptr, slot: i64):
    %bs = icmp.sge i64 slot, 16
    condbr %bs, bug(), setup(edit, ops, node, n0, n1, slot)
  setup(edit: ptr, ops: ptr, node: ptr, n0: ptr, n1: ptr, slot: i64):
    %sp = gep i8 n1, 8
    %sv = trunc i8 slot
    store i8 %sp, %sv
    br copyloop(edit, ops, node, n0, n1, slot, 0)
  copyloop(edit: ptr, ops: ptr, node: ptr, n0: ptr, n1: ptr, slot: i64, i: i64):
    %lt = icmp.slt i64 i, 16
    condbr %lt, copybody(edit, ops, node, n0, n1, slot, i), filter(edit, ops, node, n0, n1, slot)
  copybody(edit: ptr, ops: ptr, node: ptr, n0: ptr, n1: ptr, slot: i64, i: i64):
    %off = mul i64 i, 8
    %addr = gep i8 node, %off
    %pp = gep i8 %addr, 16
    %ptr = load i64, %pp
    %meta = and i64 %ptr, 1
    %dst = gep i8 n0, %off
    %dp = gep i8 %dst, 16
    %nz = icmp.ne i64 %meta, 0
    condbr %nz, copymeta(edit, ops, node, n0, n1, slot, i, %dp, %ptr), copyzero(edit, ops, node, n0, n1, slot, i, %dp)
  copymeta(edit: ptr, ops: ptr, node: ptr, n0: ptr, n1: ptr, slot: i64, i: i64, dp: ptr, ptr: i64):
    store i64 %dp, ptr
    br copynext(edit, ops, node, n0, n1, slot, i)
  copyzero(edit: ptr, ops: ptr, node: ptr, n0: ptr, n1: ptr, slot: i64, i: i64, dp: ptr):
    store i64 %dp, 0
    br copynext(edit, ops, node, n0, n1, slot, i)
  copynext(edit: ptr, ops: ptr, node: ptr, n0: ptr, n1: ptr, slot: i64, i: i64):
    %i1 = add i64 i, 1
    br copyloop(edit, ops, node, n0, n1, slot, %i1)
  filter(edit: ptr, ops: ptr, node: ptr, n0: ptr, n1: ptr, slot: i64):
    %off = mul i64 slot, 8
    %addr = gep i8 n0, %off
    %pp = gep i8 %addr, 16
    %chk = load i64, %pp
    %nz = icmp.ne i64 %chk, 0
    condbr %nz, bug(), finstall(edit, ops, node, n0, n1, slot)
  finstall(edit: ptr, ops: ptr, node: ptr, n0: ptr, n1: ptr, slot: i64):
    %n1v = call i64 kla_ptrval(n1)
    %tag = or i64 %n1v, 1
    %off = mul i64 slot, 8
    %addr = gep i8 n0, %off
    %pp = gep i8 %addr, 16
    store i64 %pp, %tag
    br floop(edit, ops, node, n0, n1, slot, 0, -1, 0)
  floop(edit: ptr, ops: ptr, node: ptr, n0: ptr, n1: ptr, slot: i64, i: i64, free_slot: i64, next_slot: i64):
    %lt = icmp.slt i64 i, 16
    condbr %lt, fbody(edit, ops, node, n0, n1, slot, i, free_slot, next_slot), fdone(edit, ops, node, n0, n1, slot, free_slot, next_slot)
  fbody(edit: ptr, ops: ptr, node: ptr, n0: ptr, n1: ptr, slot: i64, i: i64, free_slot: i64, next_slot: i64):
    %off = mul i64 i, 8
    %addr = gep i8 node, %off
    %pp = gep i8 %addr, 16
    %ptr = load i64, %pp
    %meta = and i64 %ptr, 1
    %nz = icmp.ne i64 %meta, 0
    condbr %nz, fnext(edit, ops, node, n0, n1, slot, i, free_slot, next_slot), fchk(edit, ops, node, n0, n1, slot, i, free_slot, next_slot, %ptr)
  fchk(edit: ptr, ops: ptr, node: ptr, n0: ptr, n1: ptr, slot: i64, i: i64, free_slot: i64, next_slot: i64, ptr: i64):
    %s = call i64 kla_seg_ld(edit, i)
    %eq = icmp.eq i64 %s, slot
    condbr %eq, fton1(edit, ops, node, n0, n1, slot, i, free_slot, next_slot, ptr), fton0(edit, ops, node, n0, n1, slot, i, free_slot, next_slot, ptr)
  fton1(edit: ptr, ops: ptr, node: ptr, n0: ptr, n1: ptr, slot: i64, i: i64, free_slot: i64, next_slot: i64, ptr: i64):
    %off = mul i64 next_slot, 8
    %addr = gep i8 n1, %off
    %pp = gep i8 %addr, 16
    store i64 %pp, ptr
    %np = gep i8 n1, 144
    %nr = load i64, %np
    %nr1 = add i64 %nr, 1
    store i64 %np, %nr1
    %ns1 = add i64 next_slot, 1
    br fnext(edit, ops, node, n0, n1, slot, i, free_slot, %ns1)
  fton0(edit: ptr, ops: ptr, node: ptr, n0: ptr, n1: ptr, slot: i64, i: i64, free_slot: i64, next_slot: i64, ptr: i64):
    br fscan0(edit, ops, node, n0, n1, slot, i, free_slot, next_slot, ptr, free_slot)
  fscan0(edit: ptr, ops: ptr, node: ptr, n0: ptr, n1: ptr, slot: i64, i: i64, free_slot: i64, next_slot: i64, ptr: i64, cand: i64):
    %c1 = add i64 cand, 1
    %off = mul i64 %c1, 8
    %addr = gep i8 n0, %off
    %pp = gep i8 %addr, 16
    %v = load i64, %pp
    %z = icmp.eq i64 %v, 0
    condbr %z, fput0(edit, ops, node, n0, n1, slot, i, %c1, next_slot, ptr), fscan0(edit, ops, node, n0, n1, slot, i, free_slot, next_slot, ptr, %c1)
  fput0(edit: ptr, ops: ptr, node: ptr, n0: ptr, n1: ptr, slot: i64, i: i64, free_slot: i64, next_slot: i64, ptr: i64):
    %off = mul i64 free_slot, 8
    %addr = gep i8 n0, %off
    %pp = gep i8 %addr, 16
    store i64 %pp, ptr
    br fnext(edit, ops, node, n0, n1, slot, i, free_slot, next_slot)
  fnext(edit: ptr, ops: ptr, node: ptr, n0: ptr, n1: ptr, slot: i64, i: i64, free_slot: i64, next_slot: i64):
    %i1 = add i64 i, 1
    br floop(edit, ops, node, n0, n1, slot, %i1, free_slot, next_slot)
  fdone(edit: ptr, ops: ptr, node: ptr, n0: ptr, n1: ptr, slot: i64, free_slot: i64, next_slot: i64):
    %s16 = call i64 kla_seg_ld(edit, 16)
    %eq = icmp.eq i64 %s16, slot
    condbr %eq, leafn1(edit, ops, node, n0, n1, slot, free_slot, next_slot), leafn0(edit, ops, node, n0, n1, slot, free_slot, next_slot)
  leafn0(edit: ptr, ops: ptr, node: ptr, n0: ptr, n1: ptr, slot: i64, free_slot: i64, next_slot: i64):
    br lscan0(edit, ops, node, n0, n1, slot, free_slot, next_slot, free_slot)
  lscan0(edit: ptr, ops: ptr, node: ptr, n0: ptr, n1: ptr, slot: i64, free_slot: i64, next_slot: i64, cand: i64):
    %c1 = add i64 cand, 1
    %off = mul i64 %c1, 8
    %addr = gep i8 n0, %off
    %pp = gep i8 %addr, 16
    %v = load i64, %pp
    %z = icmp.eq i64 %v, 0
    condbr %z, lput0(edit, n0, next_slot, %c1), lscan0(edit, ops, node, n0, n1, slot, free_slot, next_slot, %c1)
  lput0(edit: ptr, n0: ptr, next_slot: i64, free_slot: i64):
    %off = mul i64 free_slot, 8
    %addr = gep i8 n0, %off
    %pp = gep i8 %addr, 16
    %av = call i64 kla_ptrval(%pp)
    call void kla_edit_st(edit, 48, %av)
    %n0v = call i64 kla_ptrval(n0)
    call void kla_edit_st(edit, 240, %n0v)
    br tailchk(edit, ops, node, n0, n1, next_slot)
  leafn1(edit: ptr, ops: ptr, node: ptr, n0: ptr, n1: ptr, slot: i64, free_slot: i64, next_slot: i64):
    %off = mul i64 next_slot, 8
    %addr = gep i8 n1, %off
    %pp = gep i8 %addr, 16
    %av = call i64 kla_ptrval(%pp)
    call void kla_edit_st(edit, 48, %av)
    %n1v = call i64 kla_ptrval(n1)
    call void kla_edit_st(edit, 240, %n1v)
    %ns1 = add i64 next_slot, 1
    br tailchk(edit, ops, node, n0, n1, %ns1)
  tailchk(edit: ptr, ops: ptr, node: ptr, n0: ptr, n1: ptr, next_slot: i64):
    %le = icmp.sle i64 next_slot, 1
    condbr %le, bug(), backptrs(edit, ops, node, n0, n1)
  backptrs(edit: ptr, ops: ptr, node: ptr, n0: ptr, n1: ptr):
    %n0v = call i64 kla_ptrval(n0)
    %tag = or i64 %n0v, 1
    call void kla_edit_st(edit, 232, %tag)
    br bploop(edit, ops, node, n0, n1, 0)
  bploop(edit: ptr, ops: ptr, node: ptr, n0: ptr, n1: ptr, i: i64):
    %lt = icmp.slt i64 i, 16
    condbr %lt, bpbody(edit, ops, node, n0, n1, i), setptr(edit, node)
  bpbody(edit: ptr, ops: ptr, node: ptr, n0: ptr, n1: ptr, i: i64):
    %s = call i64 kla_seg_ld(edit, i)
    %ff = icmp.eq i64 %s, 255
    condbr %ff, bpwork(edit, ops, node, n0, n1, i), bpnext(edit, ops, node, n0, n1, i)
  bpwork(edit: ptr, ops: ptr, node: ptr, n0: ptr, n1: ptr, i: i64):
    %off = mul i64 i, 8
    %addr = gep i8 node, %off
    %pp = gep i8 %addr, 16
    %ptr = load i64, %pp
    %leaf = and i64 %ptr, 1
    %z = icmp.eq i64 %leaf, 0
    condbr %z, bug(), bpaddr(edit, ops, node, n0, n1, i, %ptr)
  bpaddr(edit: ptr, ops: ptr, node: ptr, n0: ptr, n1: ptr, i: i64, ptr: i64):
    %base = and i64 ptr, -4
    %obj = call ptr kla_fromval(%base)
    %av = call i64 kla_ptrval(%obj)
    br bpstore(edit, ops, node, n0, n1, i, %av)
  bpstore(edit: ptr, ops: ptr, node: ptr, n0: ptr, n1: ptr, i: i64, av: i64):
    %off = mul i64 i, 8
    %eoff = add i64 104, %off
    call void kla_edit_st(edit, %eoff, av)
    br bpnext(edit, ops, node, n0, n1, i)
  bpnext(edit: ptr, ops: ptr, node: ptr, n0: ptr, n1: ptr, i: i64):
    %i1 = add i64 i, 1
    br bploop(edit, ops, node, n0, n1, %i1)
  setptr(edit: ptr, node: ptr):
    %bp = load i64, node
    %z = icmp.eq i64 %bp, 0
    condbr %z, setroot(edit), setchk(edit, node, %bp)
  setroot(edit: ptr):
    %arr = call i64 kla_edit_ld(edit, 16)
    call void kla_edit_st(edit, 256, %arr)
    br fin(edit, node)
  setchk(edit: ptr, node: ptr, bp: i64):
    %nd = and i64 bp, 2
    %z = icmp.eq i64 %nd, 0
    condbr %z, setnode(edit, node, bp), setsc(edit, node, bp)
  setnode(edit: ptr, node: ptr, bp: i64):
    %base = and i64 bp, -4
    %par = call ptr kla_fromval(%base)
    %sp = gep i8 node, 8
    %ps = load i8, %sp
    %ps64 = zext i64 %ps
    %off = mul i64 %ps64, 8
    %addr = gep i8 %par, %off
    %pp = gep i8 %addr, 16
    %av = call i64 kla_ptrval(%pp)
    call void kla_edit_st(edit, 256, %av)
    br fin(edit, node)
  setsc(edit: ptr, node: ptr, bp: i64):
    %base = and i64 bp, -4
    %sc = call ptr kla_fromval(%base)
    %pp = gep i8 %sc, 16
    %av = call i64 kla_ptrval(%pp)
    call void kla_edit_st(edit, 256, %av)
    br fin(edit, node)
  fin(edit: ptr, node: ptr):
