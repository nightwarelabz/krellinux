  st_empty(edit: ptr):
    %ok = call i64 kla_insert_in_empty_tree(edit)
    %nz = icmp.ne i64 %ok, 0
    condbr %nz, retedit(edit), enomem(edit)
  chk_term(edit: ptr, ops: ptr, key: ptr, st: i64, onode: ptr, olevel: ptr, oslot: ptr, osc: ptr, osclevel: ptr, oscseg: ptr, odiss: ptr):
    %eq = icmp.eq i64 st, 1
    condbr %eq, st_term(edit, ops, key, onode, olevel, oslot), st_wrong(edit, ops, osc, olevel, osclevel, oscseg, odiss)
  st_term(edit: ptr, ops: ptr, key: ptr, onode: ptr, olevel: ptr, oslot: ptr):
    %node = load ptr, %onode
