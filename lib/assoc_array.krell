    call void kla_edit_st(edit, 264, %tag)
    %bp = load i64, %sc
    store i64 %n0, %bp
    %sp = gep i8 %sc, 8
    %ps = load i32, %sp
    %ps8 = trunc i8 %ps
    %tp = gep i8 n0, 8
    store i8 %tp, %ps8
    br side(edit, sc, scsegs, diff, n0)
  side(edit: ptr, sc: ptr, scsegs: i64, diff: i64, n0: ptr):
    %np = gep i8 %sc, 16
    %nn = load i64, %np
    %base = and i64 %nn, -4
    %side = call ptr kla_fromval(%base)
    %nrp = gep i8 %side, 144
    %nr = load i64, %nrp
    %tn = gep i8 n0, 144
    store i64 %tn, %nr
    %sh = and i64 diff, 63
    %seg = lshr i64 %scsegs, %sh
    %scslot = and i64 %seg, 15
    %l2 = add i64 diff, 4
    %kp = gep i8 %sc, 12
    %skip32 = load i32, %kp
    %skip = sext i64 %skip32
    %lt = icmp.slt i64 %l2, %skip
    condbr %lt, postsc(edit, sc, n0, %side, %scslot, %skip), nopost(edit, sc, n0, %side, %scslot)
  postsc(edit: ptr, sc: ptr, n0: ptr, side: ptr, scslot: i64, skip: i64):
    %ru = add i64 skip, 63
    %ru2 = and i64 %ru, -64
    %keylen = lshr i64 %ru2, 6
    %bytes = mul i64 %keylen, 8
    %size = add i64 %bytes, 24
    %s1 = call ptr kla_kzalloc(%size)
    %s1v = call i64 kla_ptrval(%s1)
    %z = icmp.eq i64 %s1v, 0
    condbr %z, fail(), postsc2(edit, sc, n0, side, scslot, skip, %keylen, %s1, %s1v)
  postsc2(edit: ptr, sc: ptr, n0: ptr, side: ptr, scslot: i64, skip: i64, keylen: i64, s1: ptr, s1v: i64):
    %tag = or i64 s1v, 3
    call void kla_edit_st(edit, 80, %tag)
    %n0v = call i64 kla_ptrval(n0)
    %n0t = or i64 %n0v, 1
    store i64 %s1, %n0t
    %tp = gep i8 %s1, 8
    %ss32 = trunc i32 scslot
    store i32 %tp, %ss32
    %np = gep i8 %sc, 16
    %nn = load i64, %np
    %tp2 = gep i8 %s1, 16
    store i64 %tp2, %nn
    %kp = gep i8 %sc, 12
    %skip32 = load i32, %kp
    %tk = gep i8 %s1, 12
    store i32 %tk, %skip32
    %off = mul i64 scslot, 8
    %addr = gep i8 n0, %off
    %pp = gep i8 %addr, 16
    store i64 %pp, %tag
    %src = gep i8 %sc, 24
    %dst = gep i8 %s1, 24
    %nbytes = mul i64 %keylen, 8
    %r = call ptr memcpy(%dst, %src, %nbytes)
    %sav = call i64 kla_ptrval(%side)
    call void kla_edit_st(edit, 272, %sav)
