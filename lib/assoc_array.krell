    %slot = load i64, %oslot
    %ok = call i64 kla_insert_terminal(edit, ops, key, %node, %level, %slot)
    %nz = icmp.ne i64 %ok, 0
    condbr %nz, retedit(edit), enomem(edit)
  st_wrong(edit: ptr, ops: ptr, osc: ptr, olevel: ptr, osclevel: ptr, oscseg: ptr, odiss: ptr):
    %sc = load ptr, %osc
    %level = load i64, %olevel
    %sclevel = load i64, %osclevel
    %scseg = load i64, %oscseg
    %diss = load i64, %odiss
    %ok = call i64 kla_insert_mid_sc(edit, ops, %sc, %level, %sclevel, %scseg, %diss)
    %nz = icmp.ne i64 %ok, 0
    condbr %nz, retedit(edit), enomem(edit)
  retedit(edit: ptr):
    ret edit
  enomem(edit: ptr):
    call void assoc_array_cancel_edit(edit)
    br enomem0()
  enomem0():
    %e = call ptr kla_errptr()
    ret %e
  bug():
    call void kla_bug()
    %e = call ptr kla_errptr()
    ret %e
