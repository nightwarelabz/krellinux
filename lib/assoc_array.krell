fn kla_delete_collapse_iterator(ptr, ptr) -> i32 {
  entry(leaf: ptr, data: ptr):
    %lv = call i64 kla_ptrval(leaf)
    %skip = gep i8 data, 8
    %skipv = load i64, %skip
    %eq = icmp.eq i64 %lv, %skipv
    condbr %eq, retzero(), go(leaf, data, %lv)
  go(leaf: ptr, data: ptr, lv: i64):
    %sp = gep i8 data, 16
    %slot32 = load i32, %sp
    %slot = sext i64 %slot32
    %ge = icmp.sge i64 %slot, 16
    condbr %ge, bug(), put(data, lv, %slot)
  put(data: ptr, lv: i64, slot: i64):
    %np = load ptr, data
    %off = mul i64 slot, 8
    %addr = gep i8 %np, %off
    %pp = gep i8 %addr, 16
    store i64 %pp, lv
    %sp = gep i8 data, 16
    %s1 = add i64 slot, 1
    %s32 = trunc i32 %s1
    store i32 %sp, %s32
    ret 0
  retzero():
    ret 0
  bug():
    call void kla_bug()
    ret 0
