fn kla_insert_terminal(ptr, ptr, ptr, ptr, i64, i64) -> i64 {
  entry(edit: ptr, ops: ptr, key: ptr, node: ptr, level: i64, tslot: i64):
    call void kla_seg_st(edit, 16, tslot)
    br scan(edit, ops, key, node, level, 0, -1)
  scan(edit: ptr, ops: ptr, key: ptr, node: ptr, level: i64, i: i64, free_slot: i64):
    %lt = icmp.slt i64 i, 16
    condbr %lt, sbody(edit, ops, key, node, level, i, free_slot), scanned(edit, ops, key, node, level, free_slot)
  sbody(edit: ptr, ops: ptr, key: ptr, node: ptr, level: i64, i: i64, free_slot: i64):
    %off = mul i64 i, 8
    %addr = gep i8 node, %off
    %pp = gep i8 %addr, 16
    %ptr = load i64, %pp
    %z = icmp.eq i64 %ptr, 0
