fn kla_insert_mid_sc(ptr, ptr, ptr, i64, i64, i64, i64) -> i64 {
  entry(edit: ptr, ops: ptr, sc: ptr, level: i64, sclevel: i64, scsegs: i64, diss: i64):
    %diff0 = ctz i64 diss
    %diff1 = and i64 %diff0, -4
    %base = and i64 sclevel, -64
    %diff = add i64 %diff1, %base
    %bp = load i64, %sc
    %z = icmp.eq i64 %bp, 0
    condbr %z, rootset(edit), bpset(edit, %sc, %bp)
  rootset(edit: ptr):
    %arr = call i64 kla_edit_ld(edit, 16)
    call void kla_edit_st(edit, 256, %arr)
    br excise(edit, %sc, level, sclevel, scsegs, %diff)
  bpset(edit: ptr, sc: ptr, bp: i64):
    %nd = and i64 bp, 2
    %z = icmp.eq i64 %nd, 0
    condbr %z, nodeset(edit, sc, bp), bug()
  nodeset(edit: ptr, sc: ptr, bp: i64):
    %base = and i64 bp, -4
    %par = call ptr kla_fromval(%base)
    %sp = gep i8 %sc, 8
    %ps = load i32, %sp
    %ps64 = sext i64 %ps
    %off = mul i64 %ps64, 8
    %addr = gep i8 %par, %off
    %pp = gep i8 %addr, 16
    %av = call i64 kla_ptrval(%pp)
    call void kla_edit_st(edit, 256, %av)
    br excise(edit, sc, level, sclevel, scsegs, %diff)
  excise(edit: ptr, sc: ptr, level: i64, sclevel: i64, scsegs: i64, diff: i64):
    %sv = call i64 kla_ptrval(%sc)
    %tag = or i64 %sv, 3
