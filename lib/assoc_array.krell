    %nz = icmp.ne i64 %meta, 0
    condbr %nz, cf_meta(edit, ops, key, node, level, n0, n1, i), cf_leaf(edit, ops, key, node, level, n0, n1, i, have_meta, %ptr)
  cf_meta(edit: ptr, ops: ptr, key: ptr, node: ptr, level: i64, n0: ptr, n1: ptr, i: i64):
    call void kla_seg_st(edit, i, 255)
    %i1 = add i64 i, 1
    br cf_loop(edit, ops, key, node, level, n0, n1, %i1, 1)
  cf_leaf(edit: ptr, ops: ptr, key: ptr, node: ptr, level: i64, n0: ptr, n1: ptr, i: i64, have_meta: i64, ptr: i64):
    %base = and i64 ptr, -2
    %leaf = call ptr kla_fromval(%base)
