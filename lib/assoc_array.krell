fn assoc_array_clear(ptr, ptr) -> ptr {
  entry(array: ptr, ops: ptr):
    %root = load i64, array
    %z = icmp.eq i64 %root, 0
    condbr %z, nullret(), alloc(array, ops, %root)
  alloc(array: ptr, ops: ptr, root: i64):
    %edit = call ptr kla_kzalloc(328)
    %ev = call i64 kla_ptrval(%edit)
    %z = icmp.eq i64 %ev, 0
    condbr %z, enomem0(), setup(array, ops, root, %edit)
  setup(array: ptr, ops: ptr, root: i64, edit: ptr):
    %av = call i64 kla_ptrval(array)
    call void kla_edit_st(edit, 16, %av)
    %opv = call i64 kla_ptrval(ops)
    call void kla_edit_st(edit, 24, %opv)
    call void kla_edit_st(edit, 272, %av)
    call void kla_edit_st(edit, 280, 0)
    call void kla_edit_st(edit, 96, root)
    call void kla_edit_st(edit, 32, %opv)
    ret edit
  enomem0():
    %e = call ptr kla_errptr()
    ret %e
  nullret():
    %null = call ptr kla_null()
    ret %null
}

fn assoc_array_cancel_edit(ptr) -> void {
  entry(edit: ptr):
    br loop(edit, 0)
  loop(edit: ptr, i: i64):
    %lt = icmp.slt i64 i, 3
    condbr %lt, body(edit, i), fin(edit)
  body(edit: ptr, i: i64):
    %off = mul i64 i, 8
    %eo = add i64 %off, 64
    %v = call i64 kla_edit_ld(edit, %eo)
    %nz = icmp.ne i64 %v, 0
    condbr %nz, free(edit, i, %v), next(edit, i)
  free(edit: ptr, i: i64, v: i64):
    %base = and i64 v, -4
    %obj = call ptr kla_fromval(%base)
    call void kfree(%obj)
    br next(edit, i)
  next(edit: ptr, i: i64):
    %i1 = add i64 i, 1
    br loop(edit, %i1)
  fin(edit: ptr):
    call void kfree(edit)
    ret
}

fn kla_rcu_cleanup(ptr) -> void {
  entry(edit: ptr):
    %dead = call i64 kla_edit_ld(edit, 56)
    %nz = icmp.ne i64 %dead, 0
    condbr %nz, freedead(edit, %dead), meta(edit)
  freedead(edit: ptr, dead: i64):
    %opv = call i64 kla_edit_ld(edit, 24)
    %ops = call ptr kla_fromval(%opv)
    %base = and i64 %dead, -2
    %leaf = call ptr kla_fromval(%base)
    call void kla_call_free(%ops, 32, %leaf)
    br meta(edit)
  meta(edit: ptr):
    %em = call i64 kla_edit_ld(edit, 88)
    %nz = icmp.ne i64 %em, 0
    condbr %nz, freemeta(edit, %em), subtree(edit)
  freemeta(edit: ptr, em: i64):
    %base = and i64 em, -4
    %obj = call ptr kla_fromval(%base)
    call void kfree(%obj)
    br subtree(edit)
  subtree(edit: ptr):
    %es = call i64 kla_edit_ld(edit, 96)
    %nz = icmp.ne i64 %es, 0
    condbr %nz, subchk(edit, %es), fin(edit)
  subchk(edit: ptr, es: i64):
    %leaf = and i64 %es, 1
    %z = icmp.eq i64 %leaf, 0
    condbr %z, bug(), subgo(edit, %es)
  subgo(edit: ptr, es: i64):
    %base = and i64 %es, -4
    %obj = call ptr kla_fromval(%base)
    store i64 %obj, 0
    %opv = call i64 kla_edit_ld(edit, 32)
    %ops = call ptr kla_fromval(%opv)
    call void kla_destroy_subtree(%es, %ops)
    br fin(edit)
  fin(edit: ptr):
    call void kfree(edit)
    ret
  bug():
    call void kla_bug()
    ret
}

fn assoc_array_apply_edit(ptr) -> void {
  entry(edit: ptr):
    fence.release
    %lp = call i64 kla_edit_ld(edit, 48)
    %nz = icmp.ne i64 %lp, 0
    condbr %nz, setleaf(edit, %lp), f2(edit)
  setleaf(edit: ptr, lp: i64):
    %leaf = call i64 kla_edit_ld(edit, 40)
    %addr = call ptr kla_fromval(lp)
    store i64 %addr, %leaf
    br f2(edit)
  f2(edit: ptr):
    fence.release
    %pp = call i64 kla_edit_ld(edit, 288)
    %nz = icmp.ne i64 %pp, 0
    condbr %nz, setps(edit, %pp), f3(edit)
  setps(edit: ptr, pp: i64):
    %ep = gep i8 edit, 296
    %to = load i8, %ep
    %addr = call ptr kla_fromval(pp)
    store i8 %addr, %to
    br f3(edit)
  f3(edit: ptr):
    fence.release
    br bploop(edit, 0)
  bploop(edit: ptr, i: i64):
    %lt = icmp.slt i64 i, 16
    condbr %lt, bpbody(edit, i), f4(edit)
  bpbody(edit: ptr, i: i64):
    %off = mul i64 i, 8
    %eo = add i64 %off, 104
    %bp = call i64 kla_edit_ld(edit, %eo)
    %nz = icmp.ne i64 %bp, 0
    condbr %nz, bpset(edit, i, %bp), bpnext(edit, i)
  bpset(edit: ptr, i: i64, bp: i64):
    %to = call i64 kla_edit_ld(edit, 232)
    %addr = call ptr kla_fromval(bp)
    store i64 %addr, %to
    br bpnext(edit, i)
  bpnext(edit: ptr, i: i64):
    %i1 = add i64 i, 1
    br bploop(edit, %i1)
  f4(edit: ptr):
    fence.release
    br setloop(edit, 0)
  setloop(edit: ptr, i: i64):
    %lt = icmp.slt i64 i, 2
    condbr %lt, setbody(edit, i), counts(edit)
  setbody(edit: ptr, i: i64):
    %off = mul i64 i, 16
    %eo = add i64 %off, 256
    %p = call i64 kla_edit_ld(edit, %eo)
    %nz = icmp.ne i64 %p, 0
    condbr %nz, setdo(edit, i, %p), setnext(edit, i)
  setdo(edit: ptr, i: i64, p: i64):
    %off = mul i64 i, 16
    %eo = add i64 %off, 264
    %to = call i64 kla_edit_ld(edit, %eo)
    %addr = call ptr kla_fromval(p)
    store i64 %addr, %to
    br setnext(edit, i)
  setnext(edit: ptr, i: i64):
    %i1 = add i64 i, 1
    br setloop(edit, %i1)
  counts(edit: ptr):
    %av = call i64 kla_edit_ld(edit, 16)
    %array = call ptr kla_fromval(%av)
    %root = load i64, %array
    %z = icmp.eq i64 %root, 0
    condbr %z, zero(array, edit), adjchk(edit, %array)
  zero(array: ptr, edit: ptr):
    %np = gep i8 %array, 8
    store i64 %np, 0
    br rcu(edit)
  adjchk(edit: ptr, array: ptr):
    %adj = call i64 kla_edit_ld(edit, 240)
    %nz = icmp.ne i64 %adj, 0
    condbr %nz, adjloop(edit, array, %adj), rcu(edit)
  adjloop(edit: ptr, array: ptr, nodev: i64):
    %base = and i64 nodev, -4
    %node = call ptr kla_fromval(%base)
    %nrp = gep i8 %node, 144
    %nr = load i64, %nrp
    %by = call i64 kla_edit_ld(edit, 248)
    %nr2 = add i64 %nr, %by
    store i64 %nrp, %nr2
    %bp = load i64, %node
    %z = icmp.eq i64 %bp, 0
    condbr %z, addtree(edit, array), adjsc(edit, array, %bp)
  adjsc(edit: ptr, array: ptr, bp: i64):
    %sc = and i64 bp, 2
    %nz = icmp.ne i64 %sc, 0
    condbr %nz, adjsc2(edit, array, bp), adjnode(edit, array, bp)
  adjsc2(edit: ptr, array: ptr, bp: i64):
    %base = and i64 bp, -4
    %sc = call ptr kla_fromval(%base)
    %nbp = load i64, %sc
    %z = icmp.eq i64 %nbp, 0
    condbr %z, addtree(edit, array), adjnode(edit, array, %nbp)
  adjnode(edit: ptr, array: ptr, bp: i64):
    %isnode = and i64 bp, 2
    %nz = icmp.ne i64 %isnode, 0
    condbr %nz, bug(), adjloop(edit, array, bp)
  addtree(edit: ptr, array: ptr):
    %np = gep i8 %array, 8
    %nr = load i64, %np
    %by = call i64 kla_edit_ld(edit, 248)
    %nr2 = add i64 %nr, %by
    store i64 %np, %nr2
    br rcu(edit)
  rcu(edit: ptr):
    %fn = funcptr kla_rcu_cleanup
    call void call_rcu(edit, %fn)
    ret
  bug():
    call void kla_bug()
    ret
}

fn assoc_array_gc(ptr, ptr, ptr, ptr) -> i32 {
  entry(array: ptr, ops: ptr, iter: ptr, data: ptr):
    %slot = alloca 8, 8
    store ptr %slot, iter
    %root = load i64, array
    %z = icmp.eq i64 %root, 0
    condbr %z, retzero(), alloc(array, ops, %slot, data, %root)
  alloc(array: ptr, ops: ptr, iter: ptr, data: ptr, root: i64):
    %edit = call ptr kla_kzalloc(328)
    %ev = call i64 kla_ptrval(%edit)
    %z = icmp.eq i64 %ev, 0
    condbr %z, enomem0(), setup(array, ops, iter, data, root, %edit)
  setup(array: ptr, ops: ptr, iter: ptr, data: ptr, root: i64, edit: ptr):
    %av = call i64 kla_ptrval(array)
    call void kla_edit_st(edit, 16, %av)
    %opv = call i64 kla_ptrval(ops)
    call void kla_edit_st(edit, 24, %opv)
    call void kla_edit_st(edit, 32, %opv)
    call void kla_edit_st(edit, 256, %av)
    call void kla_edit_st(edit, 96, root)
    %slot = alloca 8, 8
    store i64 %slot, 0
    br descend(array, ops, iter, data, edit, %slot, root, 0, %slot, 0)
  descend(array: ptr, ops: ptr, iter: ptr, data: ptr, edit: ptr, root_slot: ptr, cursor: i64, new_parent: i64, new_pp: ptr, nr_tree: i64):
    %sc = and i64 cursor, 2
    %nz = icmp.ne i64 %sc, 0
    condbr %nz, sc_dup(array, ops, iter, data, edit, root_slot, cursor, new_parent, new_pp, nr_tree), node_dup(array, ops, iter, data, edit, root_slot, cursor, new_parent, new_pp, nr_tree)
  sc_dup(array: ptr, ops: ptr, iter: ptr, data: ptr, edit: ptr, root_slot: ptr, cursor: i64, new_parent: i64, new_pp: ptr, nr_tree: i64):
    %base = and i64 cursor, -4
    %sc = call ptr kla_fromval(%base)
    %kp = gep i8 %sc, 12
    %skip32 = load i32, %kp
    %skip = sext i64 %skip32
    %ru = add i64 %skip, 63
    %ru2 = and i64 %ru, -64
    %keylen = lshr i64 %ru2, 6
    %bytes = mul i64 %keylen, 8
    %size = add i64 %bytes, 24
    %ns = call ptr __kmalloc_noprof(%size, 3276)
    %nv = call i64 kla_ptrval(%ns)
    %z = icmp.eq i64 %nv, 0
    condbr %z, enomem(edit, root_slot, ops), sc_dup2(array, ops, iter, data, edit, root_slot, %sc, new_parent, new_pp, nr_tree, %keylen, %size, %ns, %nv)
  sc_dup2(array: ptr, ops: ptr, iter: ptr, data: ptr, edit: ptr, root_slot: ptr, sc: ptr, new_parent: i64, new_pp: ptr, nr_tree: i64, keylen: i64, size: i64, ns: ptr, nsv: i64):
    %r = call ptr memcpy(%ns, %sc, size)
    store i64 %ns, new_parent
    %sp = gep i8 %sc, 8
    %ps = load i32, %sp
    %tp = gep i8 %ns, 8
    store i32 %tp, %ps
    %tag = or i64 %nsv, 3
    store i64 %new_pp, %tag
    %npp = gep i8 %ns, 16
    %np2 = gep i8 %sc, 16
    %nn = load i64, %np2
    br node_dup(array, ops, iter, data, edit, root_slot, %nn, %tag, %npp, nr_tree)
  node_dup(array: ptr, ops: ptr, iter: ptr, data: ptr, edit: ptr, root_slot: ptr, cursor: i64, new_parent: i64, new_pp: ptr, nr_tree: i64):
    %base = and i64 cursor, -4
    %node = call ptr kla_fromval(%base)
    %nn = call ptr kla_kzalloc(152)
    %nv = call i64 kla_ptrval(%nn)
    %z = icmp.eq i64 %nv, 0
    condbr %z, enomem(edit, root_slot, ops), node_dup2(array, ops, iter, data, edit, root_slot, %node, new_parent, new_pp, nr_tree, %nn, %nv)
  node_dup2(array: ptr, ops: ptr, iter: ptr, data: ptr, edit: ptr, root_slot: ptr, node: ptr, new_parent: i64, new_pp: ptr, nr_tree: i64, nn: ptr, nnv: i64):
    store i64 %nn, new_parent
    %sp = gep i8 %node, 8
    %ps = load i8, %sp
    %tp = gep i8 %nn, 8
    store i8 %tp, %ps
    %tag = or i64 %nnv, 1
    store i64 %new_pp, %tag
    br continue_node(array, ops, iter, data, edit, root_slot, node, %nn, 0, nr_tree)
  continue_node(array: ptr, ops: ptr, iter: ptr, data: ptr, edit: ptr, root_slot: ptr, node: ptr, new_n: ptr, slot: i64, nr_tree: i64):
    %lt = icmp.slt i64 slot, 16
    condbr %lt, cn_body(array, ops, iter, data, edit, root_slot, node, new_n, slot, nr_tree), compress(array, ops, iter, data, edit, root_slot, node, new_n, nr_tree)
  cn_body(array: ptr, ops: ptr, iter: ptr, data: ptr, edit: ptr, root_slot: ptr, node: ptr, new_n: ptr, slot: i64, nr_tree: i64):
    %off = mul i64 slot, 8
    %addr = gep i8 %node, %off
    %pp = gep i8 %addr, 16
    %ptr = load i64, %pp
    %z = icmp.eq i64 %ptr, 0
    condbr %z, cn_next(array, ops, iter, data, edit, root_slot, node, new_n, slot, nr_tree), cn_chk(array, ops, iter, data, edit, root_slot, node, new_n, slot, nr_tree, %ptr)
  cn_chk(array: ptr, ops: ptr, iter: ptr, data: ptr, edit: ptr, root_slot: ptr, node: ptr, new_n: ptr, slot: i64, nr_tree: i64, ptr: i64):
    %leaf = and i64 ptr, 1
    %z = icmp.eq i64 %leaf, 0
    condbr %z, cn_leaf(array, ops, iter, data, edit, root_slot, node, new_n, slot, nr_tree, ptr), cn_meta(array, ops, iter, data, edit, root_slot, node, new_n, slot, nr_tree, ptr)
  cn_leaf(array: ptr, ops: ptr, iter: ptr, data: ptr, edit: ptr, root_slot: ptr, node: ptr, new_n: ptr, slot: i64, nr_tree: i64, ptr: i64):
    %base = and i64 ptr, -2
    %leaf = call ptr kla_fromval(%base)
    %r = call i32 kla_call_gciter(%iter, %leaf, data)
    %nz = icmp.ne i32 %r, 0
    condbr %nz, cn_keep(array, ops, iter, data, edit, root_slot, node, new_n, slot, nr_tree, ptr), cn_next(array, ops, iter, data, edit, root_slot, node, new_n, slot, nr_tree)
  cn_keep(array: ptr, ops: ptr, iter: ptr, data: ptr, edit: ptr, root_slot: ptr, node: ptr, new_n: ptr, slot: i64, nr_tree: i64, ptr: i64):
    %off = mul i64 slot, 8
    %addr = gep i8 %new_n, %off
    %pp = gep i8 %addr, 16
    store i64 %pp, ptr
    br cn_next(array, ops, iter, data, edit, root_slot, node, new_n, slot, nr_tree)
  cn_meta(array: ptr, ops: ptr, iter: ptr, data: ptr, edit: ptr, root_slot: ptr, node: ptr, new_n: ptr, slot: i64, nr_tree: i64, ptr: i64):
    %off = mul i64 slot, 8
    %addr = gep i8 %new_n, %off
    %npp = gep i8 %addr, 16
    %nv = call i64 kla_ptrval(%new_n)
    %tag = or i64 %nv, 1
    br descend(array, ops, iter, data, edit, root_slot, ptr, %tag, %npp, nr_tree)
  cn_next(array: ptr, ops: ptr, iter: ptr, data: ptr, edit: ptr, root_slot: ptr, node: ptr, new_n: ptr, slot: i64, nr_tree: i64):
    %s1 = add i64 slot, 1
    br continue_node(array, ops, iter, data, edit, root_slot, node, new_n, %s1, nr_tree)
  compress(array: ptr, ops: ptr, iter: ptr, data: ptr, edit: ptr, root_slot: ptr, node: ptr, new_n: ptr, nr_tree: i64):
    br cnt_loop(array, ops, iter, data, edit, root_slot, node, new_n, nr_tree, 0, 0, 0)
  cnt_loop(array: ptr, ops: ptr, iter: ptr, data: ptr, edit: ptr, root_slot: ptr, node: ptr, new_n: ptr, nr_tree: i64, slot: i64, nr: i64, nr_free: i64):
    %lt = icmp.slt i64 slot, 16
    condbr %lt, cnt_body(array, ops, iter, data, edit, root_slot, node, new_n, nr_tree, slot, nr, nr_free), cnt_done(array, ops, iter, data, edit, root_slot, node, new_n, nr_tree, nr, nr_free)
  cnt_body(array: ptr, ops: ptr, iter: ptr, data: ptr, edit: ptr, root_slot: ptr, node: ptr, new_n: ptr, nr_tree: i64, slot: i64, nr: i64, nr_free: i64):
    %off = mul i64 slot, 8
    %addr = gep i8 %new_n, %off
    %pp = gep i8 %addr, 16
    %ptr = load i64, %pp
    %z = icmp.eq i64 %ptr, 0
    condbr %z, cnt_free(array, ops, iter, data, edit, root_slot, node, new_n, nr_tree, slot, nr, nr_free), cnt_leaf(array, ops, iter, data, edit, root_slot, node, new_n, nr_tree, slot, nr, nr_free, %ptr)
  cnt_free(array: ptr, ops: ptr, iter: ptr, data: ptr, edit: ptr, root_slot: ptr, node: ptr, new_n: ptr, nr_tree: i64, slot: i64, nr: i64, nr_free: i64):
    %f1 = add i64 nr_free, 1
    %s1 = add i64 slot, 1
    br cnt_loop(array, ops, iter, data, edit, root_slot, node, new_n, nr_tree, %s1, nr, %f1)
  cnt_leaf(array: ptr, ops: ptr, iter: ptr, data: ptr, edit: ptr, root_slot: ptr, node: ptr, new_n: ptr, nr_tree: i64, slot: i64, nr: i64, nr_free: i64, ptr: i64):
    %leaf = and i64 ptr, 1
    %z = icmp.eq i64 %leaf, 0
    condbr %z, cnt_inc(array, ops, iter, data, edit, root_slot, node, new_n, nr_tree, slot, nr, nr_free), cnt_next(array, ops, iter, data, edit, root_slot, node, new_n, nr_tree, slot, nr, nr_free)
  cnt_inc(array: ptr, ops: ptr, iter: ptr, data: ptr, edit: ptr, root_slot: ptr, node: ptr, new_n: ptr, nr_tree: i64, slot: i64, nr: i64, nr_free: i64):
    %n1 = add i64 nr, 1
    %s1 = add i64 slot, 1
    br cnt_loop(array, ops, iter, data, edit, root_slot, node, new_n, nr_tree, %s1, %n1, nr_free)
  cnt_next(array: ptr, ops: ptr, iter: ptr, data: ptr, edit: ptr, root_slot: ptr, node: ptr, new_n: ptr, nr_tree: i64, slot: i64, nr: i64, nr_free: i64):
    %s1 = add i64 slot, 1
    br cnt_loop(array, ops, iter, data, edit, root_slot, node, new_n, nr_tree, %s1, nr, nr_free)
  cnt_done(array: ptr, ops: ptr, iter: ptr, data: ptr, edit: ptr, root_slot: ptr, node: ptr, new_n: ptr, nr_tree: i64, nr: i64, nr_free: i64):
    %nrp = gep i8 %new_n, 144
    store i64 %nrp, nr
    br fold_loop(array, ops, iter, data, edit, root_slot, node, new_n, nr_tree, 0, nr, nr_free, 0, 0)
  fold_loop(array: ptr, ops: ptr, iter: ptr, data: ptr, edit: ptr, root_slot: ptr, node: ptr, new_n: ptr, nr_tree: i64, slot: i64, nr: i64, nr_free: i64, retained: i64, next_slot: i64):
    %lt = icmp.slt i64 slot, 16
