fn kla_errptr() -> ptr {
  entry():
    %p = call ptr kla_fromval(-12)
    ret %p
}

fn assoc_array_insert(ptr, ptr, ptr, ptr) -> ptr {
  entry(array: ptr, ops: ptr, key: ptr, object: ptr):
    %ov = call i64 kla_ptrval(object)
    %meta = and i64 %ov, 1
    %nz = icmp.ne i64 %meta, 0
    condbr %nz, bug(), alloc(array, ops, key, object, %ov)
  alloc(array: ptr, ops: ptr, key: ptr, object: ptr, ov: i64):
    %edit = call ptr kla_kzalloc(328)
    %ev = call i64 kla_ptrval(%edit)
    %z = icmp.eq i64 %ev, 0
    condbr %z, enomem0(), setup(array, ops, key, object, ov, %edit)
  setup(array: ptr, ops: ptr, key: ptr, object: ptr, ov: i64, edit: ptr):
    %av = call i64 kla_ptrval(array)
    call void kla_edit_st(edit, 16, %av)
    %opv = call i64 kla_ptrval(ops)
    call void kla_edit_st(edit, 24, %opv)
    call void kla_edit_st(edit, 40, ov)
    call void kla_edit_st(edit, 248, 1)
    %onode = alloca 8, 8
    %olevel = alloca 8, 8
    %oslot = alloca 8, 8
    %osc = alloca 8, 8
    %osclevel = alloca 8, 8
    %oscseg = alloca 8, 8
    %odiss = alloca 8, 8
