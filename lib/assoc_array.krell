  markfree(edit: ptr, ops: ptr, key: ptr, node: ptr, level: i64, i: i64):
    %i1 = add i64 i, 1
    br scan(edit, ops, key, node, level, %i1, i)
  schk(edit: ptr, ops: ptr, key: ptr, node: ptr, level: i64, i: i64, free_slot: i64, ptr: i64):
    %leaf = and i64 ptr, 1
    %z = icmp.eq i64 %leaf, 0
    condbr %z, scmp(edit, ops, key, node, level, i, free_slot, ptr), snext(edit, ops, key, node, level, i, free_slot)
  scmp(edit: ptr, ops: ptr, key: ptr, node: ptr, level: i64, i: i64, free_slot: i64, ptr: i64):
