  cf_loop(edit: ptr, ops: ptr, key: ptr, node: ptr, level: i64, n0: ptr, n1: ptr, i: i64, have_meta: i64):
    %lt = icmp.slt i64 i, 16
    condbr %lt, cf_body(edit, ops, key, node, level, n0, n1, i, have_meta), cf_done(edit, ops, key, node, level, n0, n1, have_meta)
  cf_body(edit: ptr, ops: ptr, key: ptr, node: ptr, level: i64, n0: ptr, n1: ptr, i: i64, have_meta: i64):
    %off = mul i64 i, 8
    %addr = gep i8 node, %off
    %pp = gep i8 %addr, 16
    %ptr = load i64, %pp
