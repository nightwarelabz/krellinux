    %off = mul i64 slot, 8
    %addr = gep i8 %new_n, %off
    %pp = gep i8 %addr, 16
    %ptr = load i64, %pp
    %z = icmp.eq i64 %ptr, 0
    condbr %z, fold_next(array, ops, iter, data, edit, root_slot, node, new_n, nr_tree, slot, nr, nr_free, retained, next_slot), fold_chk(array, ops, iter, data, edit, root_slot, node, new_n, nr_tree, slot, nr, nr_free, retained, next_slot, %ptr)
  fold_chk(array: ptr, ops: ptr, iter: ptr, data: ptr, edit: ptr, root_slot: ptr, node: ptr, new_n: ptr, nr_tree: i64, slot: i64, nr: i64, nr_free: i64, retained: i64, next_slot: i64, ptr: i64):
    %leaf = and i64 ptr, 1
    %z = icmp.eq i64 %leaf, 0
    condbr %z, fold_next(array, ops, iter, data, edit, root_slot, node, new_n, nr_tree, slot, nr, nr_free, retained, next_slot), fold_meta(array, ops, iter, data, edit, root_slot, node, new_n, nr_tree, slot, nr, nr_free, retained, next_slot, ptr)
  fold_meta(array: ptr, ops: ptr, iter: ptr, data: ptr, edit: ptr, root_slot: ptr, node: ptr, new_n: ptr, nr_tree: i64, slot: i64, nr: i64, nr_free: i64, retained: i64, next_slot: i64, ptr: i64):
    %sc = and i64 ptr, 2
    %nz = icmp.ne i64 %sc, 0
    condbr %nz, fold_sc(array, ops, iter, data, edit, root_slot, node, new_n, nr_tree, slot, nr, nr_free, retained, next_slot, ptr), fold_child(array, ops, iter, data, edit, root_slot, node, new_n, nr_tree, slot, nr, nr_free, retained, next_slot, ptr, 0)
  fold_sc(array: ptr, ops: ptr, iter: ptr, data: ptr, edit: ptr, root_slot: ptr, node: ptr, new_n: ptr, nr_tree: i64, slot: i64, nr: i64, nr_free: i64, retained: i64, next_slot: i64, ptr: i64):
    %base = and i64 ptr, -4
    %s = call ptr kla_fromval(%base)
    %np = gep i8 %s, 16
    %nn = load i64, %np
    %sv = call i64 kla_ptrval(%s)
    br fold_child(array, ops, iter, data, edit, root_slot, node, new_n, nr_tree, slot, nr, nr_free, retained, next_slot, %nn, %sv)
  fold_child(array: ptr, ops: ptr, iter: ptr, data: ptr, edit: ptr, root_slot: ptr, node: ptr, new_n: ptr, nr_tree: i64, slot: i64, nr: i64, nr_free: i64, retained: i64, next_slot: i64, childptr: i64, s: i64):
    %base = and i64 childptr, -4
    %child = call ptr kla_fromval(%base)
    %nrp = gep i8 %child, 144
    %cnr = load i64, %nrp
    %nr2 = add i64 nr, %cnr
    %lim = add i64 nr_free, 1
    %le = icmp.ule i64 %cnr, %lim
    condbr %le, fold_do(array, ops, iter, data, edit, root_slot, node, new_n, nr_tree, slot, %nr2, nr_free, retained, next_slot, %child, s), fold_retain(array, ops, iter, data, edit, root_slot, node, new_n, nr_tree, slot, %nr2, nr_free, next_slot)
  fold_retain(array: ptr, ops: ptr, iter: ptr, data: ptr, edit: ptr, root_slot: ptr, node: ptr, new_n: ptr, nr_tree: i64, slot: i64, nr: i64, nr_free: i64, next_slot: i64):
    br fold_next(array, ops, iter, data, edit, root_slot, node, new_n, nr_tree, slot, nr, nr_free, 1, next_slot)
  fold_do(array: ptr, ops: ptr, iter: ptr, data: ptr, edit: ptr, root_slot: ptr, node: ptr, new_n: ptr, nr_tree: i64, slot: i64, nr: i64, nr_free: i64, retained: i64, next_slot: i64, child: ptr, s: i64):
    %nz = icmp.ne i64 s, 0
    condbr %nz, bug(), fold_do2(array, ops, iter, data, edit, root_slot, node, new_n, nr_tree, slot, nr, nr_free, retained, next_slot, child)
  fold_do2(array: ptr, ops: ptr, iter: ptr, data: ptr, edit: ptr, root_slot: ptr, node: ptr, new_n: ptr, nr_tree: i64, slot: i64, nr: i64, nr_free: i64, retained: i64, next_slot: i64, child: ptr):
    %off = mul i64 slot, 8
    %addr = gep i8 %new_n, %off
    %pp = gep i8 %addr, 16
    store i64 %pp, 0
    %f1 = add i64 nr_free, 1
    %back = icmp.slt i64 slot, next_slot
    condbr %back, fold_do3(array, ops, iter, data, edit, root_slot, node, new_n, nr_tree, slot, nr, %f1, retained, slot, child), fold_do3(array, ops, iter, data, edit, root_slot, node, new_n, nr_tree, slot, nr, %f1, retained, next_slot, child)
