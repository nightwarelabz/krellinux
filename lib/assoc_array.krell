  alloc3(edit: ptr, ops: ptr, key: ptr, node: ptr, level: i64, n0: ptr, n1: ptr, n1v: i64):
    %tag1 = or i64 n1v, 1
    call void kla_edit_st(edit, 72, %tag1)
