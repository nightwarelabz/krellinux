; SPDX-License-Identifier: GPL-2.0-only
; lib/bitmap.c converted to Krell (Phase 1 batch 5).
;
; The word-loop operations are operation-for-operation
; mirrors.  Notes:
; - test_bit()/set_bit() from the remap family: the C forms
;   are the arch bitops (locked BTS on x86); set_bit is
;   mirrored with an atomic aor, test_bit with a plain load
;   and test, which is its observable result.
; - bitmap_zero() is an inline that memsets the words; the
;   Krell form zeroes them with a loop (klbm_zero), the same
;   contract.
; - bitmap_pos_to_ord() is a file-local static in C; it is
;   klbm_pos_to_ord here.
; - The allocation wrappers call the slab entry points
;   the kmalloc_array / kmalloc_array_node inlines reduce
;   to (__kmalloc_noprof / __kmalloc_node_noprof), and
;   kfree, externally, as in C.
;   __GFP_ZERO is 0x100, GFP flags pass through.
; - Residue: devm_bitmap_alloc / devm_bitmap_zalloc stay C
;   -- they register the file-local static devm_bitmap_free
;   callback with devm_add_action_or_reset, and that static
;   function's address cannot be named from Krell.
; - bitmap_from_arr64 / bitmap_to_arr64 are 32-bit-only
;   (BITS_PER_LONG == 32) and have no x86_64 instance.

extern memset(ptr, i32, i64) -> ptr
extern memmove(ptr, ptr, i64) -> ptr
; kmalloc_array / kmalloc_array_node are slab.h inlines in C:
; bytes = n * size (the overflow check cannot fire for a
; u32 nbits: BITS_TO_LONGS(nbits) * 8 < 2^30), then the
; non-constant path of _kmalloc_noprof / _kmalloc_array_node
; lands in __kmalloc_noprof / __kmalloc_node_noprof.
extern __kmalloc_noprof(i64, i32) -> ptr
extern __kmalloc_node_noprof(i64, i32, i32) -> ptr
extern kfree(ptr) -> void
extern _find_first_bit(ptr, i64) -> i64
extern _find_next_bit(ptr, i64, i64) -> i64
extern _find_next_zero_bit(ptr, i64, i64) -> i64
extern _find_last_bit(ptr, i64) -> i64
extern __find_nth_bit(ptr, i64, i64) -> i64

fn klbm_lastmask(i64) -> i64 {
  entry(n: i64):
    %m = and i64 n, 63
    %nz = icmp.ne i64 %m, 0
    %sh = shl i64 1, %m
    %mm = sub i64 %sh, 1
    %all = sub i64 0, 1
    %r = select i64 %nz, %mm, %all
    ret %r
}

; pointer identity through the alloca type-punning bridge
fn klbm_ptreq(ptr, ptr) -> i64 {
  entry(a: ptr, b: ptr):
    %slot = alloca 8, 8
    store i64 %slot, 0
    store ptr %slot, a
    %av = load i64, %slot
    store ptr %slot, b
    %bv = load i64, %slot
    %eq = icmp.eq i64 %av, %bv
    %r = select i64 %eq, 1, 0
    ret %r
}

fn klbm_zero(ptr, i64) -> void {
  entry(dst: ptr, nr: i64):
    br head(dst, nr, 0)
  head(dst: ptr, nr: i64, k: i64):
    %c = icmp.ult i64 k, nr
    condbr %c, body(dst, nr, k), done()
  body(dst: ptr, nr: i64, k: i64):
    %p = gep i64 dst, k
    store i64 %p, 0
    %k2 = add i64 k, 1
    br head(dst, nr, %k2)
  done():
    ret
}

fn klbm_set_bit(i64, ptr) -> void {
  entry(nr: i64, addr: ptr):
    %idx = udiv i64 nr, 64
    %p = gep i64 addr, %idx
    %off = and i64 nr, 63
    %m = shl i64 1, %off
    %old = aor.acqrel i64 %p, %m
    ret
}

fn klbm_test_bit(i64, ptr) -> i64 {
  entry(nr: i64, addr: ptr):
    %idx = udiv i64 nr, 64
    %p = gep i64 addr, %idx
    %w = load i64, %p
    %off = and i64 nr, 63
    %v = lshr i64 %w, %off
    %r = and i64 %v, 1
    ret %r
}

fn __bitmap_equal(ptr, ptr, i32) -> i64 {
  entry(b1: ptr, b2: ptr, bits32: i32):
    %bits = zext i64 bits32
    %lim = udiv i64 %bits, 64
    br head(b1, b2, %bits, %lim, 0)
  head(b1: ptr, b2: ptr, bits: i64, lim: i64, k: i64):
    %c = icmp.ult i64 k, lim
    condbr %c, body(b1, b2, bits, lim, k), tail(b1, b2, bits, k)
  body(b1: ptr, b2: ptr, bits: i64, lim: i64, k: i64):
    %p1 = gep i64 b1, k
    %x = load i64, %p1
    %p2 = gep i64 b2, k
    %y = load i64, %p2
    %ne = icmp.ne i64 %x, %y
    condbr %ne, no(), next(b1, b2, bits, lim, k)
  next(b1: ptr, b2: ptr, bits: i64, lim: i64, k: i64):
    %k2 = add i64 k, 1
    br head(b1, b2, bits, lim, %k2)
  tail(b1: ptr, b2: ptr, bits: i64, k: i64):
    %m = and i64 bits, 63
    %nz = icmp.ne i64 %m, 0
    condbr %nz, check(b1, b2, bits, k), yes()
  check(b1: ptr, b2: ptr, bits: i64, k: i64):
    %p1 = gep i64 b1, k
    %x = load i64, %p1
    %p2 = gep i64 b2, k
    %y = load i64, %p2
    %d = xor i64 %x, %y
    %lm = call i64 klbm_lastmask(bits)
    %t = and i64 %d, %lm
    %z = icmp.eq i64 %t, 0
    condbr %z, yes(), no()
  yes():
    ret 1
  no():
    ret 0
}

fn __bitmap_or_equal(ptr, ptr, ptr, i32) -> i64 {
  entry(b1: ptr, b2: ptr, b3: ptr, bits32: i32):
    %bits = zext i64 bits32
    %lim = udiv i64 %bits, 64
    br head(b1, b2, b3, %bits, %lim, 0)
  head(b1: ptr, b2: ptr, b3: ptr, bits: i64, lim: i64, k: i64):
    %c = icmp.ult i64 k, lim
    condbr %c, body(b1, b2, b3, bits, lim, k), tail(b1, b2, b3, bits, k)
  body(b1: ptr, b2: ptr, b3: ptr, bits: i64, lim: i64, k: i64):
    %p1 = gep i64 b1, k
    %x = load i64, %p1
    %p2 = gep i64 b2, k
    %y = load i64, %p2
    %p3 = gep i64 b3, k
    %z = load i64, %p3
    %o = or i64 %x, %y
    %ne = icmp.ne i64 %o, %z
    condbr %ne, no(), next(b1, b2, b3, bits, lim, k)
  next(b1: ptr, b2: ptr, b3: ptr, bits: i64, lim: i64, k: i64):
    %k2 = add i64 k, 1
    br head(b1, b2, b3, bits, lim, %k2)
  tail(b1: ptr, b2: ptr, b3: ptr, bits: i64, k: i64):
    %m = and i64 bits, 63
    %nz = icmp.ne i64 %m, 0
    condbr %nz, check(b1, b2, b3, bits, k), yes()
  check(b1: ptr, b2: ptr, b3: ptr, bits: i64, k: i64):
    %p1 = gep i64 b1, k
    %x = load i64, %p1
    %p2 = gep i64 b2, k
    %y = load i64, %p2
    %p3 = gep i64 b3, k
    %z = load i64, %p3
    %o = or i64 %x, %y
    %d = xor i64 %o, %z
    %lm = call i64 klbm_lastmask(bits)
    %t = and i64 %d, %lm
    %zz = icmp.eq i64 %t, 0
    condbr %zz, yes(), no()
  yes():
    ret 1
  no():
    ret 0
}

fn __bitmap_complement(ptr, ptr, i32) -> void {
  entry(dst: ptr, src: ptr, bits32: i32):
    %bits = zext i64 bits32
    %t = add i64 %bits, 63
    %nr = udiv i64 %t, 64
    br head(dst, src, %nr, 0)
  head(dst: ptr, src: ptr, nr: i64, k: i64):
    %c = icmp.ult i64 k, nr
    condbr %c, body(dst, src, nr, k), done()
  body(dst: ptr, src: ptr, nr: i64, k: i64):
    %p = gep i64 src, k
    %x = load i64, %p
    %all = sub i64 0, 1
    %v = xor i64 %x, %all
    %q = gep i64 dst, k
    store i64 %q, %v
    %k2 = add i64 k, 1
    br head(dst, src, nr, %k2)
  done():
    ret
}

fn __bitmap_shift_right(ptr, ptr, i32, i32) -> void {
  entry(dst: ptr, src: ptr, sh32: i32, nb32: i32):
    %shift = zext i64 sh32
    %nbits = zext i64 nb32
    %t = add i64 %nbits, 63
    %lim = udiv i64 %t, 64
    %off = udiv i64 %shift, 64
    %rem = urem i64 %shift, 64
    %mask = call i64 klbm_lastmask(%nbits)
    br head(dst, src, %lim, %off, %rem, %mask, 0)
  head(dst: ptr, src: ptr, lim: i64, off: i64, rem: i64, mask: i64, k: i64):
    %ok = add i64 off, k
    %c = icmp.ult i64 %ok, lim
    condbr %c, body(dst, src, lim, off, rem, mask, k), tail(dst, lim, off)
  body(dst: ptr, src: ptr, lim: i64, off: i64, rem: i64, mask: i64, k: i64):
    %ok = add i64 off, k
    %rnz = icmp.ne i64 rem, 0
    condbr %rnz, chkin(dst, src, lim, off, rem, mask, k, %ok), noup(dst, src, lim, off, rem, mask, k, %ok, 0)
  chkin(dst: ptr, src: ptr, lim: i64, off: i64, rem: i64, mask: i64, k: i64, ok: i64):
    %ok1 = add i64 ok, 1
    %inb = icmp.ult i64 %ok1, lim
    condbr %inb, withup(dst, src, lim, off, rem, mask, k, ok), noup(dst, src, lim, off, rem, mask, k, ok, 0)
  withup(dst: ptr, src: ptr, lim: i64, off: i64, rem: i64, mask: i64, k: i64, ok: i64):
    %ok1 = add i64 ok, 1
    %p = gep i64 src, %ok1
    %u = load i64, %p
    %lm1 = sub i64 lim, 1
    %last = icmp.eq i64 %ok1, %lm1
    condbr %last, upl(dst, src, lim, off, rem, mask, k, ok, %u, mask), upn(dst, src, lim, off, rem, mask, k, ok, %u)
  upl(dst: ptr, src: ptr, lim: i64, off: i64, rem: i64, mask: i64, k: i64, ok: i64, u: i64, m: i64):
    %um = and i64 u, m
    br upn(dst, src, lim, off, rem, mask, k, ok, %um)
  upn(dst: ptr, src: ptr, lim: i64, off: i64, rem: i64, mask: i64, k: i64, ok: i64, u: i64):
    %sh = sub i64 64, rem
    %up = shl i64 u, %sh
    br noup(dst, src, lim, off, rem, mask, k, ok, %up)
  noup(dst: ptr, src: ptr, lim: i64, off: i64, rem: i64, mask: i64, k: i64, ok: i64, upper: i64):
    %p = gep i64 src, ok
    %lo = load i64, %p
    %lm1 = sub i64 lim, 1
    %last = icmp.eq i64 ok, %lm1
    condbr %last, lowm(dst, src, lim, off, rem, mask, k, %lo, mask, upper), lown(dst, src, lim, off, rem, mask, k, %lo, upper)
  lowm(dst: ptr, src: ptr, lim: i64, off: i64, rem: i64, mask: i64, k: i64, lo: i64, m: i64, upper: i64):
    %lom = and i64 lo, m
    br lown(dst, src, lim, off, rem, mask, k, %lom, upper)
  lown(dst: ptr, src: ptr, lim: i64, off: i64, rem: i64, mask: i64, k: i64, lo: i64, upper: i64):
    %ls = lshr i64 lo, rem
    %v = or i64 %ls, upper
    %q = gep i64 dst, k
    store i64 %q, %v
    %k2 = add i64 k, 1
    br head(dst, src, lim, off, rem, mask, %k2)
  tail(dst: ptr, lim: i64, off: i64):
    %onz = icmp.ne i64 off, 0
    condbr %onz, zero(dst, lim, off), done()
  zero(dst: ptr, lim: i64, off: i64):
    %at = sub i64 lim, off
    %q = gep i64 dst, %at
    %n = shl i64 off, 3
    %r = call ptr memset(%q, 0, %n)
    br done()
  done():
    ret
}

fn __bitmap_shift_left(ptr, ptr, i32, i32) -> void {
  entry(dst: ptr, src: ptr, sh32: i32, nb32: i32):
    %shift = zext i64 sh32
    %nbits = zext i64 nb32
    %t = add i64 %nbits, 63
    %lim = udiv i64 %t, 64
    %off = udiv i64 %shift, 64
    %rem = urem i64 %shift, 64
    %k0 = sub i64 %lim, %off
    %k1 = sub i64 %k0, 1
    br head(dst, src, %off, %rem, %k1)
  head(dst: ptr, src: ptr, off: i64, rem: i64, k: i64):
    %ge = icmp.sge i64 k, 0
    condbr %ge, body(dst, src, off, rem, k), tail(dst, off)
  body(dst: ptr, src: ptr, off: i64, rem: i64, k: i64):
    %rnz = icmp.ne i64 rem, 0
    condbr %rnz, chkp(dst, src, off, rem, k), nolo(dst, src, off, rem, k, 0)
  chkp(dst: ptr, src: ptr, off: i64, rem: i64, k: i64):
    %kp = icmp.sgt i64 k, 0
    condbr %kp, withlo(dst, src, off, rem, k), nolo(dst, src, off, rem, k, 0)
  withlo(dst: ptr, src: ptr, off: i64, rem: i64, k: i64):
    %km = sub i64 k, 1
    %p = gep i64 src, %km
    %x = load i64, %p
    %sh = sub i64 64, rem
    %lo = lshr i64 %x, %sh
    br nolo(dst, src, off, rem, k, %lo)
  nolo(dst: ptr, src: ptr, off: i64, rem: i64, k: i64, lower: i64):
    %p = gep i64 src, k
    %x = load i64, %p
    %up = shl i64 %x, rem
    %v = or i64 lower, %up
    %at = add i64 k, off
    %q = gep i64 dst, %at
    store i64 %q, %v
    %k2 = sub i64 k, 1
    br head(dst, src, off, rem, %k2)
  tail(dst: ptr, off: i64):
    %onz = icmp.ne i64 off, 0
    condbr %onz, zero(dst, off), done()
  zero(dst: ptr, off: i64):
    %n = shl i64 off, 3
    %r = call ptr memset(dst, 0, %n)
    br done()
  done():
    ret
}

fn bitmap_cut(ptr, ptr, i32, i32, i32) -> void {
  entry(dst: ptr, src: ptr, f32: i32, c32: i32, nb32: i32):
    %first = zext i64 f32
    %cut = zext i64 c32
    %nbits = zext i64 nb32
    %t = add i64 %nbits, 63
    %len = udiv i64 %t, 64
    %m6 = and i64 %first, 63
    %fnz = icmp.ne i64 %m6, 0
    condbr %fnz, keepc(dst, src, %first, %cut, %len), move(dst, src, %first, %cut, %len, 0)
  keepc(dst: ptr, src: ptr, first: i64, cut: i64, len: i64):
    %idx = udiv i64 first, 64
    %p = gep i64 src, %idx
    %w = load i64, %p
    %m6 = and i64 first, 63
    %sh = sub i64 64, %m6
    %all = sub i64 0, 1
    %km = lshr i64 %all, %sh
    %keep = and i64 %w, %km
    br move(dst, src, first, cut, len, %keep)
  move(dst: ptr, src: ptr, first: i64, cut: i64, len: i64, keep: i64):
    %n = shl i64 len, 3
    %r = call ptr memmove(dst, src, %n)
    %w0 = udiv i64 first, 64
    br outer(dst, first, cut, len, keep, %w0)
  outer(dst: ptr, first: i64, cut: i64, len: i64, keep: i64, w0: i64):
    %cz = icmp.eq i64 cut, 0
    condbr %cz, finish(dst, first, keep), pass(dst, first, cut, len, keep, w0, w0)
  pass(dst: ptr, first: i64, cut: i64, len: i64, keep: i64, w0: i64, i: i64):
    %c = icmp.ult i64 i, len
    condbr %c, pbody(dst, first, cut, len, keep, w0, i), pend(dst, first, cut, len, keep, w0)
  pbody(dst: ptr, first: i64, cut: i64, len: i64, keep: i64, w0: i64, i: i64):
    %lm1 = sub i64 len, 1
    %lt = icmp.ult i64 i, %lm1
    condbr %lt, withc(dst, first, cut, len, keep, w0, i), noc(dst, first, cut, len, keep, w0, i, 0)
  withc(dst: ptr, first: i64, cut: i64, len: i64, keep: i64, w0: i64, i: i64):
    %i1 = add i64 i, 1
    %p = gep i64 dst, %i1
    %w = load i64, %p
    %carry = and i64 %w, 1
    br noc(dst, first, cut, len, keep, w0, i, %carry)
  noc(dst: ptr, first: i64, cut: i64, len: i64, keep: i64, w0: i64, i: i64, carry: i64):
    %p = gep i64 dst, i
    %w = load i64, %p
    %lo = lshr i64 %w, 1
    %hi = shl i64 carry, 63
    %v = or i64 %lo, %hi
    store i64 %p, %v
    %i2 = add i64 i, 1
    br pass(dst, first, cut, len, keep, w0, %i2)
  pend(dst: ptr, first: i64, cut: i64, len: i64, keep: i64, w0: i64):
    %c2 = sub i64 cut, 1
    br outer(dst, first, %c2, len, keep, w0)
  finish(dst: ptr, first: i64, keep: i64):
    %idx = udiv i64 first, 64
    %p = gep i64 dst, %idx
    %w = load i64, %p
    %m6 = and i64 first, 63
    %all = sub i64 0, 1
    %fm = shl i64 %all, %m6
    %v = and i64 %w, %fm
    %v2 = or i64 %v, keep
    store i64 %p, %v2
    ret
}

fn __bitmap_and(ptr, ptr, ptr, i32) -> i64 {
  entry(dst: ptr, b1: ptr, b2: ptr, bits32: i32):
    %bits = zext i64 bits32
    %lim = udiv i64 %bits, 64
    br head(dst, b1, b2, %bits, %lim, 0, 0)
  head(dst: ptr, b1: ptr, b2: ptr, bits: i64, lim: i64, k: i64, res: i64):
    %c = icmp.ult i64 k, lim
    condbr %c, body(dst, b1, b2, bits, lim, k, res), tail(dst, b1, b2, bits, k, res)
  body(dst: ptr, b1: ptr, b2: ptr, bits: i64, lim: i64, k: i64, res: i64):
    %p1 = gep i64 b1, k
    %x = load i64, %p1
    %p2 = gep i64 b2, k
    %y = load i64, %p2
    %v = and i64 %x, %y
    %q = gep i64 dst, k
    store i64 %q, %v
    %r2 = or i64 res, %v
    %k2 = add i64 k, 1
    br head(dst, b1, b2, bits, lim, %k2, %r2)
  tail(dst: ptr, b1: ptr, b2: ptr, bits: i64, k: i64, res: i64):
    %m = and i64 bits, 63
    %nz = icmp.ne i64 %m, 0
    condbr %nz, tcheck(dst, b1, b2, bits, k, res), done(res)
  tcheck(dst: ptr, b1: ptr, b2: ptr, bits: i64, k: i64, res: i64):
    %p1 = gep i64 b1, k
    %x = load i64, %p1
    %p2 = gep i64 b2, k
    %y = load i64, %p2
    %xy = and i64 %x, %y
    %lm = call i64 klbm_lastmask(bits)
    %v = and i64 %xy, %lm
    %q = gep i64 dst, k
    store i64 %q, %v
    %r2 = or i64 res, %v
    br done(%r2)
  done(res: i64):
    %z = icmp.ne i64 res, 0
    %r = select i64 %z, 1, 0
    ret %r
}

fn __bitmap_or(ptr, ptr, ptr, i32) -> void {
  entry(dst: ptr, b1: ptr, b2: ptr, bits32: i32):
    %bits = zext i64 bits32
    %t = add i64 %bits, 63
    %nr = udiv i64 %t, 64
    br head(dst, b1, b2, %nr, 0)
  head(dst: ptr, b1: ptr, b2: ptr, nr: i64, k: i64):
    %c = icmp.ult i64 k, nr
    condbr %c, body(dst, b1, b2, nr, k), done()
  body(dst: ptr, b1: ptr, b2: ptr, nr: i64, k: i64):
    %p1 = gep i64 b1, k
    %x = load i64, %p1
    %p2 = gep i64 b2, k
    %y = load i64, %p2
    %v = or i64 %x, %y
    %q = gep i64 dst, k
    store i64 %q, %v
    %k2 = add i64 k, 1
    br head(dst, b1, b2, nr, %k2)
  done():
    ret
}

fn __bitmap_xor(ptr, ptr, ptr, i32) -> void {
  entry(dst: ptr, b1: ptr, b2: ptr, bits32: i32):
    %bits = zext i64 bits32
    %t = add i64 %bits, 63
    %nr = udiv i64 %t, 64
    br head(dst, b1, b2, %nr, 0)
  head(dst: ptr, b1: ptr, b2: ptr, nr: i64, k: i64):
    %c = icmp.ult i64 k, nr
    condbr %c, body(dst, b1, b2, nr, k), done()
  body(dst: ptr, b1: ptr, b2: ptr, nr: i64, k: i64):
    %p1 = gep i64 b1, k
    %x = load i64, %p1
    %p2 = gep i64 b2, k
    %y = load i64, %p2
    %v = xor i64 %x, %y
    %q = gep i64 dst, k
    store i64 %q, %v
    %k2 = add i64 k, 1
    br head(dst, b1, b2, nr, %k2)
  done():
    ret
}

fn __bitmap_andnot(ptr, ptr, ptr, i32) -> i64 {
  entry(dst: ptr, b1: ptr, b2: ptr, bits32: i32):
    %bits = zext i64 bits32
    %lim = udiv i64 %bits, 64
    br head(dst, b1, b2, %bits, %lim, 0, 0)
  head(dst: ptr, b1: ptr, b2: ptr, bits: i64, lim: i64, k: i64, res: i64):
    %c = icmp.ult i64 k, lim
    condbr %c, body(dst, b1, b2, bits, lim, k, res), tail(dst, b1, b2, bits, k, res)
  body(dst: ptr, b1: ptr, b2: ptr, bits: i64, lim: i64, k: i64, res: i64):
    %p1 = gep i64 b1, k
    %x = load i64, %p1
    %p2 = gep i64 b2, k
    %y = load i64, %p2
    %all = sub i64 0, 1
    %ny = xor i64 %y, %all
    %v = and i64 %x, %ny
    %q = gep i64 dst, k
    store i64 %q, %v
    %r2 = or i64 res, %v
    %k2 = add i64 k, 1
    br head(dst, b1, b2, bits, lim, %k2, %r2)
  tail(dst: ptr, b1: ptr, b2: ptr, bits: i64, k: i64, res: i64):
    %m = and i64 bits, 63
    %nz = icmp.ne i64 %m, 0
    condbr %nz, tcheck(dst, b1, b2, bits, k, res), done(res)
  tcheck(dst: ptr, b1: ptr, b2: ptr, bits: i64, k: i64, res: i64):
    %p1 = gep i64 b1, k
    %x = load i64, %p1
    %p2 = gep i64 b2, k
    %y = load i64, %p2
    %all = sub i64 0, 1
    %ny = xor i64 %y, %all
    %xy = and i64 %x, %ny
    %lm = call i64 klbm_lastmask(bits)
    %v = and i64 %xy, %lm
    %q = gep i64 dst, k
    store i64 %q, %v
    %r2 = or i64 res, %v
    br done(%r2)
  done(res: i64):
    %z = icmp.ne i64 res, 0
    %r = select i64 %z, 1, 0
    ret %r
}

fn __bitmap_replace(ptr, ptr, ptr, ptr, i32) -> void {
  entry(dst: ptr, old: ptr, new: ptr, mask: ptr, nb32: i32):
    %nbits = zext i64 nb32
    %t = add i64 %nbits, 63
    %nr = udiv i64 %t, 64
    br head(dst, old, new, mask, %nr, 0)
  head(dst: ptr, old: ptr, new: ptr, mask: ptr, nr: i64, k: i64):
    %c = icmp.ult i64 k, nr
    condbr %c, body(dst, old, new, mask, nr, k), done()
  body(dst: ptr, old: ptr, new: ptr, mask: ptr, nr: i64, k: i64):
    %po = gep i64 old, k
    %o = load i64, %po
    %pn = gep i64 new, k
    %n = load i64, %pn
    %pm = gep i64 mask, k
    %m = load i64, %pm
    %all = sub i64 0, 1
    %nm = xor i64 %m, %all
    %a = and i64 %o, %nm
    %b = and i64 %n, %m
    %v = or i64 %a, %b
    %q = gep i64 dst, k
    store i64 %q, %v
    %k2 = add i64 k, 1
    br head(dst, old, new, mask, nr, %k2)
  done():
    ret
}

fn __bitmap_intersects(ptr, ptr, i32) -> i64 {
  entry(b1: ptr, b2: ptr, bits32: i32):
    %bits = zext i64 bits32
    %lim = udiv i64 %bits, 64
    br head(b1, b2, %bits, %lim, 0)
  head(b1: ptr, b2: ptr, bits: i64, lim: i64, k: i64):
    %c = icmp.ult i64 k, lim
    condbr %c, body(b1, b2, bits, lim, k), tail(b1, b2, bits, k)
  body(b1: ptr, b2: ptr, bits: i64, lim: i64, k: i64):
    %p1 = gep i64 b1, k
    %x = load i64, %p1
    %p2 = gep i64 b2, k
    %y = load i64, %p2
    %v = and i64 %x, %y
    %nz = icmp.ne i64 %v, 0
    condbr %nz, yes(), next(b1, b2, bits, lim, k)
  next(b1: ptr, b2: ptr, bits: i64, lim: i64, k: i64):
    %k2 = add i64 k, 1
    br head(b1, b2, bits, lim, %k2)
  tail(b1: ptr, b2: ptr, bits: i64, k: i64):
    %m = and i64 bits, 63
    %nz = icmp.ne i64 %m, 0
    condbr %nz, check(b1, b2, bits, k), no()
  check(b1: ptr, b2: ptr, bits: i64, k: i64):
    %p1 = gep i64 b1, k
    %x = load i64, %p1
    %p2 = gep i64 b2, k
    %y = load i64, %p2
    %v = and i64 %x, %y
    %lm = call i64 klbm_lastmask(bits)
    %t = and i64 %v, %lm
    %z = icmp.ne i64 %t, 0
    condbr %z, yes(), no()
  yes():
    ret 1
  no():
    ret 0
}

fn __bitmap_intersects_and(ptr, ptr, ptr, i32) -> i64 {
  entry(b1: ptr, b2: ptr, b3: ptr, bits32: i32):
    %bits = zext i64 bits32
    %lim = udiv i64 %bits, 64
    br head(b1, b2, b3, %bits, %lim, 0)
  head(b1: ptr, b2: ptr, b3: ptr, bits: i64, lim: i64, k: i64):
    %c = icmp.ult i64 k, lim
    condbr %c, body(b1, b2, b3, bits, lim, k), tail(b1, b2, b3, bits, k)
  body(b1: ptr, b2: ptr, b3: ptr, bits: i64, lim: i64, k: i64):
    %p1 = gep i64 b1, k
    %x = load i64, %p1
    %p2 = gep i64 b2, k
    %y = load i64, %p2
    %p3 = gep i64 b3, k
    %z = load i64, %p3
    %xy = and i64 %x, %y
    %v = and i64 %xy, %z
    %nz = icmp.ne i64 %v, 0
    condbr %nz, yes(), next(b1, b2, b3, bits, lim, k)
  next(b1: ptr, b2: ptr, b3: ptr, bits: i64, lim: i64, k: i64):
    %k2 = add i64 k, 1
    br head(b1, b2, b3, bits, lim, %k2)
  tail(b1: ptr, b2: ptr, b3: ptr, bits: i64, k: i64):
    %m = and i64 bits, 63
    %nz = icmp.ne i64 %m, 0
    condbr %nz, check(b1, b2, b3, bits, k), no()
  check(b1: ptr, b2: ptr, b3: ptr, bits: i64, k: i64):
    %p1 = gep i64 b1, k
    %x = load i64, %p1
    %p2 = gep i64 b2, k
    %y = load i64, %p2
    %p3 = gep i64 b3, k
    %z = load i64, %p3
    %xy = and i64 %x, %y
    %v = and i64 %xy, %z
    %lm = call i64 klbm_lastmask(bits)
    %t = and i64 %v, %lm
    %zz = icmp.ne i64 %t, 0
    condbr %zz, yes(), no()
  yes():
    ret 1
  no():
    ret 0
}

fn __bitmap_subset(ptr, ptr, i32) -> i64 {
  entry(b1: ptr, b2: ptr, bits32: i32):
    %bits = zext i64 bits32
    %lim = udiv i64 %bits, 64
    br head(b1, b2, %bits, %lim, 0)
  head(b1: ptr, b2: ptr, bits: i64, lim: i64, k: i64):
    %c = icmp.ult i64 k, lim
    condbr %c, body(b1, b2, bits, lim, k), tail(b1, b2, bits, k)
  body(b1: ptr, b2: ptr, bits: i64, lim: i64, k: i64):
    %p1 = gep i64 b1, k
    %x = load i64, %p1
    %p2 = gep i64 b2, k
    %y = load i64, %p2
    %all = sub i64 0, 1
    %ny = xor i64 %y, %all
    %v = and i64 %x, %ny
    %nz = icmp.ne i64 %v, 0
    condbr %nz, no(), next(b1, b2, bits, lim, k)
  next(b1: ptr, b2: ptr, bits: i64, lim: i64, k: i64):
    %k2 = add i64 k, 1
    br head(b1, b2, bits, lim, %k2)
  tail(b1: ptr, b2: ptr, bits: i64, k: i64):
    %m = and i64 bits, 63
    %nz = icmp.ne i64 %m, 0
    condbr %nz, check(b1, b2, bits, k), yes()
  check(b1: ptr, b2: ptr, bits: i64, k: i64):
    %p1 = gep i64 b1, k
    %x = load i64, %p1
    %p2 = gep i64 b2, k
    %y = load i64, %p2
    %all = sub i64 0, 1
    %ny = xor i64 %y, %all
    %v = and i64 %x, %ny
    %lm = call i64 klbm_lastmask(bits)
    %t = and i64 %v, %lm
    %z = icmp.ne i64 %t, 0
    condbr %z, no(), yes()
  yes():
    ret 1
  no():
    ret 0
}

fn __bitmap_weight(ptr, i32) -> i32 {
  entry(bm: ptr, bits32: i32):
    %bits = zext i64 bits32
    %lim = udiv i64 %bits, 64
    br head(bm, %bits, %lim, 0, 0)
  head(bm: ptr, bits: i64, lim: i64, idx: i64, w: i64):
    %c = icmp.ult i64 idx, lim
    condbr %c, body(bm, bits, lim, idx, w), tail(bm, bits, idx, w)
  body(bm: ptr, bits: i64, lim: i64, idx: i64, w: i64):
    %p = gep i64 bm, idx
    %x = load i64, %p
    %pc = popcount i64 %x
    %w2 = add i64 w, %pc
    %i2 = add i64 idx, 1
    br head(bm, bits, lim, %i2, %w2)
  tail(bm: ptr, bits: i64, idx: i64, w: i64):
    %m = and i64 bits, 63
    %nz = icmp.ne i64 %m, 0
    condbr %nz, tcheck(bm, bits, idx, w), done(w)
  tcheck(bm: ptr, bits: i64, idx: i64, w: i64):
    %p = gep i64 bm, idx
    %x = load i64, %p
    %lm = call i64 klbm_lastmask(bits)
    %v = and i64 %x, %lm
    %pc = popcount i64 %v
    %w2 = add i64 w, %pc
    br done(%w2)
  done(w: i64):
    %r = trunc i32 w
    ret %r
}

fn __bitmap_weight_and(ptr, ptr, i32) -> i32 {
  entry(b1: ptr, b2: ptr, bits32: i32):
    %bits = zext i64 bits32
    %lim = udiv i64 %bits, 64
    br head(b1, b2, %bits, %lim, 0, 0)
  head(b1: ptr, b2: ptr, bits: i64, lim: i64, idx: i64, w: i64):
    %c = icmp.ult i64 idx, lim
    condbr %c, body(b1, b2, bits, lim, idx, w), tail(b1, b2, bits, idx, w)
