    condbr %nz, tcheck(b1, b2, bits, idx, w), done(w)
  tcheck(b1: ptr, b2: ptr, bits: i64, idx: i64, w: i64):
    %p1 = gep i64 b1, idx
    %x = load i64, %p1
    %p2 = gep i64 b2, idx
    %y = load i64, %p2
    %all = sub i64 0, 1
    %ny = xor i64 %y, %all
    %v = and i64 %x, %ny
    %lm = call i64 klbm_lastmask(bits)
    %vm = and i64 %v, %lm
    %pc = popcount i64 %vm
    %w2 = add i64 w, %pc
    br done(%w2)
  done(w: i64):
    %r = trunc i32 w
    ret %r
}

fn __bitmap_weighted_or(ptr, ptr, ptr, i32) -> i32 {
  entry(dst: ptr, b1: ptr, b2: ptr, bits32: i32):
    %bits = zext i64 bits32
    %lim = udiv i64 %bits, 64
    br head(dst, b1, b2, %bits, %lim, 0, 0)
  head(dst: ptr, b1: ptr, b2: ptr, bits: i64, lim: i64, idx: i64, w: i64):
    %c = icmp.ult i64 idx, lim
    condbr %c, body(dst, b1, b2, bits, lim, idx, w), tail(dst, b1, b2, bits, idx, w)
  body(dst: ptr, b1: ptr, b2: ptr, bits: i64, lim: i64, idx: i64, w: i64):
    %p1 = gep i64 b1, idx
    %x = load i64, %p1
    %p2 = gep i64 b2, idx
    %y = load i64, %p2
    %v = or i64 %x, %y
    %q = gep i64 dst, idx
    store i64 %q, %v
    %pc = popcount i64 %v
    %w2 = add i64 w, %pc
    %i2 = add i64 idx, 1
    br head(dst, b1, b2, bits, lim, %i2, %w2)
  tail(dst: ptr, b1: ptr, b2: ptr, bits: i64, idx: i64, w: i64):
    %m = and i64 bits, 63
    %nz = icmp.ne i64 %m, 0
    condbr %nz, tcheck(dst, b1, b2, bits, idx, w), done(w)
  tcheck(dst: ptr, b1: ptr, b2: ptr, bits: i64, idx: i64, w: i64):
    %p1 = gep i64 b1, idx
    %x = load i64, %p1
    %p2 = gep i64 b2, idx
    %y = load i64, %p2
    %v = or i64 %x, %y
    %q = gep i64 dst, idx
    store i64 %q, %v
    %lm = call i64 klbm_lastmask(bits)
    %vm = and i64 %v, %lm
    %pc = popcount i64 %vm
    %w2 = add i64 w, %pc
    br done(%w2)
  done(w: i64):
    %r = trunc i32 w
    ret %r
}

fn __bitmap_weighted_xor(ptr, ptr, ptr, i32) -> i32 {
  entry(dst: ptr, b1: ptr, b2: ptr, bits32: i32):
    %bits = zext i64 bits32
    %lim = udiv i64 %bits, 64
    br head(dst, b1, b2, %bits, %lim, 0, 0)
  head(dst: ptr, b1: ptr, b2: ptr, bits: i64, lim: i64, idx: i64, w: i64):
    %c = icmp.ult i64 idx, lim
    condbr %c, body(dst, b1, b2, bits, lim, idx, w), tail(dst, b1, b2, bits, idx, w)
  body(dst: ptr, b1: ptr, b2: ptr, bits: i64, lim: i64, idx: i64, w: i64):
    %p1 = gep i64 b1, idx
    %x = load i64, %p1
    %p2 = gep i64 b2, idx
    %y = load i64, %p2
    %v = xor i64 %x, %y
    %q = gep i64 dst, idx
    store i64 %q, %v
    %pc = popcount i64 %v
    %w2 = add i64 w, %pc
    %i2 = add i64 idx, 1
    br head(dst, b1, b2, bits, lim, %i2, %w2)
  tail(dst: ptr, b1: ptr, b2: ptr, bits: i64, idx: i64, w: i64):
    %m = and i64 bits, 63
    %nz = icmp.ne i64 %m, 0
    condbr %nz, tcheck(dst, b1, b2, bits, idx, w), done(w)
  tcheck(dst: ptr, b1: ptr, b2: ptr, bits: i64, idx: i64, w: i64):
    %p1 = gep i64 b1, idx
    %x = load i64, %p1
    %p2 = gep i64 b2, idx
    %y = load i64, %p2
    %v = xor i64 %x, %y
    %q = gep i64 dst, idx
    store i64 %q, %v
    %lm = call i64 klbm_lastmask(bits)
    %vm = and i64 %v, %lm
    %pc = popcount i64 %vm
    %w2 = add i64 w, %pc
    br done(%w2)
  done(w: i64):
    %r = trunc i32 w
    ret %r
}

fn __bitmap_set(ptr, i32, i32) -> void {
  entry(map: ptr, st32: i32, len32: i32):
    %start = zext i64 st32
    %len = sext i64 len32
    %sum = add i32 st32, len32
    %size = zext i64 %sum
    %wi = udiv i64 %start, 64
    %p = gep i64 map, %wi
    %m6 = and i64 %start, 63
    %bts = sub i64 64, %m6
    %all = sub i64 0, 1
    %mask = shl i64 %all, %m6
    br head(%p, %len, %bts, %mask, %size)
  head(p: ptr, len: i64, bts: i64, mask: i64, size: i64):
    %d = sub i64 len, bts
    %ge = icmp.sge i64 %d, 0
    condbr %ge, body(p, len, bts, mask, size), tail(p, len, mask, size)
  body(p: ptr, len: i64, bts: i64, mask: i64, size: i64):
    %w = load i64, p
    %v = or i64 %w, mask
    store i64 p, %v
    %len2 = sub i64 len, bts
    %p2 = gep i64 p, 1
    %all = sub i64 0, 1
    br head(%p2, %len2, 64, %all, size)
  tail(p: ptr, len: i64, mask: i64, size: i64):
    %nz = icmp.ne i64 len, 0
    condbr %nz, tcheck(p, mask, size), done()
  tcheck(p: ptr, mask: i64, size: i64):
    %lm = call i64 klbm_lastmask(size)
    %m = and i64 mask, %lm
    %w = load i64, p
    %v = or i64 %w, %m
    store i64 p, %v
    br done()
  done():
    ret
}

fn __bitmap_clear(ptr, i32, i32) -> void {
  entry(map: ptr, st32: i32, len32: i32):
    %start = zext i64 st32
    %len = sext i64 len32
    %sum = add i32 st32, len32
    %size = zext i64 %sum
    %wi = udiv i64 %start, 64
    %p = gep i64 map, %wi
    %m6 = and i64 %start, 63
    %btc = sub i64 64, %m6
    %all = sub i64 0, 1
    %mask = shl i64 %all, %m6
    br head(%p, %len, %btc, %mask, %size)
  head(p: ptr, len: i64, btc: i64, mask: i64, size: i64):
    %d = sub i64 len, btc
    %ge = icmp.sge i64 %d, 0
    condbr %ge, body(p, len, btc, mask, size), tail(p, len, mask, size)
  body(p: ptr, len: i64, btc: i64, mask: i64, size: i64):
    %w = load i64, p
    %all = sub i64 0, 1
    %nm = xor i64 mask, %all
    %v = and i64 %w, %nm
    store i64 p, %v
    %len2 = sub i64 len, btc
    %p2 = gep i64 p, 1
    %all2 = sub i64 0, 1
    br head(%p2, %len2, 64, %all2, size)
  tail(p: ptr, len: i64, mask: i64, size: i64):
    %nz = icmp.ne i64 len, 0
    condbr %nz, tcheck(p, mask, size), done()
  tcheck(p: ptr, mask: i64, size: i64):
    %lm = call i64 klbm_lastmask(size)
    %m = and i64 mask, %lm
    %w = load i64, p
    %all = sub i64 0, 1
    %nm = xor i64 %m, %all
    %v = and i64 %w, %nm
    store i64 p, %v
    br done()
  done():
    ret
}

fn bitmap_find_next_zero_area_off(ptr, i64, i64, i32, i64, i64) -> i64 {
  entry(map: ptr, size: i64, start0: i64, nr32: i32, amask: i64, aoff: i64):
    %nr = zext i64 nr32
    %s = call i64 _find_next_zero_bit(map, size, start0)
    br head(map, size, %s, %nr, amask, aoff)
  head(map: ptr, size: i64, start: i64, nr: i64, amask: i64, aoff: i64):
    %c = icmp.ult i64 start, size
    condbr %c, body(map, size, start, nr, amask, aoff), done(size)
  body(map: ptr, size: i64, start: i64, nr: i64, amask: i64, aoff: i64):
    %t1 = add i64 start, aoff
    %t2 = add i64 %t1, amask
    %all = sub i64 0, 1
    %nam = xor i64 amask, %all
    %t3 = and i64 %t2, %nam
    %st = sub i64 %t3, aoff
    %end = add i64 %st, nr
    %over = icmp.ugt i64 %end, size
    condbr %over, done(size), scan(map, size, %st, %end, nr, amask, aoff)
  scan(map: ptr, size: i64, st: i64, end: i64, nr: i64, amask: i64, aoff: i64):
    %off = and i64 st, -64
    %wi = udiv i64 st, 64
    %sub = gep i64 map, %wi
    %span = sub i64 end, %off
    %lb = call i64 _find_last_bit(%sub, %span)
    %i = add i64 %lb, %off
    %ge = icmp.uge i64 %i, end
    condbr %ge, hit(%st), chk2(map, size, %st, %i, nr, amask, aoff)
  chk2(map: ptr, size: i64, st: i64, i: i64, nr: i64, amask: i64, aoff: i64):
    %lt = icmp.ult i64 i, st
    condbr %lt, hit(%st), again(map, size, %i, nr, amask, aoff)
  again(map: ptr, size: i64, i: i64, nr: i64, amask: i64, aoff: i64):
    %ip1 = add i64 i, 1
    %s = call i64 _find_next_zero_bit(map, size, %ip1)
    br head(map, size, %s, nr, amask, aoff)
  hit(st: i64):
    ret %st
  done(size: i64):
    ret size
}

fn klbm_pos_to_ord(ptr, i32, i32) -> i32 {
  entry(buf: ptr, pos32: i32, nb32: i32):
    %ge = icmp.uge i32 pos32, nb32
    condbr %ge, neg(), chk(buf, pos32, nb32)
  chk(buf: ptr, pos32: i32, nb32: i32):
    %pos = zext i64 pos32
    %tb = call i64 klbm_test_bit(%pos, buf)
    %z = icmp.eq i64 %tb, 0
    condbr %z, neg(), go(buf, pos32)
  go(buf: ptr, pos32: i32):
    %w = call i32 __bitmap_weight(buf, pos32)
    ret %w
  neg():
    %m = sub i32 0, 1
    ret %m
}

fn bitmap_remap(ptr, ptr, ptr, ptr, i32) -> void {
  entry(dst: ptr, src: ptr, old: ptr, new: ptr, nb32: i32):
    %eq = call i64 klbm_ptreq(dst, src)
    %isz = icmp.ne i64 %eq, 0
    condbr %isz, done(), go(dst, src, old, new, nb32)
  go(dst: ptr, src: ptr, old: ptr, new: ptr, nb32: i32):
    %nbits = zext i64 nb32
    %t = add i64 %nbits, 63
    %nr = udiv i64 %t, 64
    call void klbm_zero(dst, %nr)
    %w = call i32 __bitmap_weight(new, nb32)
    %wz = zext i64 %w
    %first = call i64 _find_first_bit(src, %nbits)
    br head(dst, src, old, new, nb32, %nbits, %wz, %first)
  head(dst: ptr, src: ptr, old: ptr, new: ptr, nb32: i32, nbits: i64, w: i64, bit: i64):
    %c = icmp.ult i64 bit, nbits
    condbr %c, body(dst, src, old, new, nb32, nbits, w, bit), done()
  body(dst: ptr, src: ptr, old: ptr, new: ptr, nb32: i32, nbits: i64, w: i64, bit: i64):
    %b32 = trunc i32 bit
    %n = call i32 klbm_pos_to_ord(old, %b32, nb32)
    %nlt = icmp.slt i32 %n, 0
    condbr %nlt, ident(dst, src, old, new, nb32, nbits, w, bit), chkz(dst, src, old, new, nb32, nbits, w, bit, %n)
  chkz(dst: ptr, src: ptr, old: ptr, new: ptr, nb32: i32, nbits: i64, w: i64, bit: i64, n: i32):
    %wz = icmp.eq i64 w, 0
    condbr %wz, ident(dst, src, old, new, nb32, nbits, w, bit), mapped(dst, src, old, new, nb32, nbits, w, bit, n)
  ident(dst: ptr, src: ptr, old: ptr, new: ptr, nb32: i32, nbits: i64, w: i64, bit: i64):
    call void klbm_set_bit(bit, dst)
    br next(dst, src, old, new, nb32, nbits, w, bit)
  mapped(dst: ptr, src: ptr, old: ptr, new: ptr, nb32: i32, nbits: i64, w: i64, bit: i64, n: i32):
    %ne = sext i64 n
    %m = urem i64 %ne, w
    %tgt = call i64 __find_nth_bit(new, nbits, %m)
    call void klbm_set_bit(%tgt, dst)
    br next(dst, src, old, new, nb32, nbits, w, bit)
  next(dst: ptr, src: ptr, old: ptr, new: ptr, nb32: i32, nbits: i64, w: i64, bit: i64):
    %bp1 = add i64 bit, 1
    %nb = call i64 _find_next_bit(src, nbits, %bp1)
    br head(dst, src, old, new, nb32, nbits, w, %nb)
  done():
    ret
}

fn bitmap_bitremap(i32, ptr, ptr, i32) -> i32 {
  entry(ob32: i32, old: ptr, new: ptr, bits32: i32):
    %w = call i32 __bitmap_weight(new, bits32)
    %n = call i32 klbm_pos_to_ord(old, ob32, bits32)
    %nlt = icmp.slt i32 %n, 0
    condbr %nlt, id(ob32), chkz(ob32, new, bits32, %w, %n)
  chkz(ob32: i32, new: ptr, bits32: i32, w: i32, n: i32):
    %wz = icmp.eq i32 w, 0
    condbr %wz, id(ob32), mapped(new, bits32, w, n)
  mapped(new: ptr, bits32: i32, w: i32, n: i32):
    %ne = sext i64 n
    %we = sext i64 w
    %m = urem i64 %ne, %we
    %bits = sext i64 bits32
    %t = call i64 __find_nth_bit(new, %bits, %m)
    %r = trunc i32 %t
    ret %r
  id(ob32: i32):
    ret ob32
}

fn bitmap_onto(ptr, ptr, ptr, i32) -> void {
  entry(dst: ptr, orig: ptr, relmap: ptr, bits32: i32):
    %eq = call i64 klbm_ptreq(dst, orig)
    %isz = icmp.ne i64 %eq, 0
    condbr %isz, done(), go(dst, orig, relmap, bits32)
  go(dst: ptr, orig: ptr, relmap: ptr, bits32: i32):
    %bits = zext i64 bits32
    %t = add i64 %bits, 63
    %nr = udiv i64 %t, 64
    call void klbm_zero(dst, %nr)
    %first = call i64 _find_first_bit(relmap, %bits)
    br head(dst, orig, relmap, %bits, %first, 0)
  head(dst: ptr, orig: ptr, relmap: ptr, bits: i64, n: i64, m: i64):
    %c = icmp.ult i64 n, bits
    condbr %c, body(dst, orig, relmap, bits, n, m), done()
  body(dst: ptr, orig: ptr, relmap: ptr, bits: i64, n: i64, m: i64):
    %tb = call i64 klbm_test_bit(m, orig)
    %nz = icmp.ne i64 %tb, 0
    condbr %nz, setb(dst, orig, relmap, bits, n, m), next(dst, orig, relmap, bits, n, m)
  setb(dst: ptr, orig: ptr, relmap: ptr, bits: i64, n: i64, m: i64):
    call void klbm_set_bit(n, dst)
    br next(dst, orig, relmap, bits, n, m)
  next(dst: ptr, orig: ptr, relmap: ptr, bits: i64, n: i64, m: i64):
    %np1 = add i64 n, 1
    %nn = call i64 _find_next_bit(relmap, bits, %np1)
    %m2 = add i64 m, 1
    br head(dst, orig, relmap, bits, %nn, %m2)
  done():
    ret
}

fn bitmap_fold(ptr, ptr, i32, i32) -> void {
  entry(dst: ptr, orig: ptr, sz32: i32, nb32: i32):
    %eq = call i64 klbm_ptreq(dst, orig)
    %isz = icmp.ne i64 %eq, 0
    condbr %isz, done(), go(dst, orig, sz32, nb32)
  go(dst: ptr, orig: ptr, sz32: i32, nb32: i32):
    %nbits = zext i64 nb32
    %t = add i64 %nbits, 63
    %nr = udiv i64 %t, 64
    call void klbm_zero(dst, %nr)
    %sz = zext i64 sz32
    %first = call i64 _find_first_bit(orig, %nbits)
    br head(dst, orig, %sz, %nbits, %first)
  head(dst: ptr, orig: ptr, sz: i64, nbits: i64, bit: i64):
    %c = icmp.ult i64 bit, nbits
    condbr %c, body(dst, orig, sz, nbits, bit), done()
  body(dst: ptr, orig: ptr, sz: i64, nbits: i64, bit: i64):
    %m = urem i64 bit, sz
    call void klbm_set_bit(%m, dst)
    %bp1 = add i64 bit, 1
    %nb = call i64 _find_next_bit(orig, nbits, %bp1)
    br head(dst, orig, sz, nbits, %nb)
  done():
    ret
}

fn bitmap_alloc(i32, i32) -> ptr {
  entry(nb32: i32, flags: i32):
    %nbits = zext i64 nb32
    %t = add i64 %nbits, 63
    %nr = udiv i64 %t, 64
    %bytes = mul i64 %nr, 8
    %r = call ptr __kmalloc_noprof(%bytes, flags)
    ret %r
}

fn bitmap_zalloc(i32, i32) -> ptr {
  entry(nb32: i32, flags: i32):
    %f2 = or i32 flags, 256
    %r = call ptr bitmap_alloc(nb32, %f2)
    ret %r
}

fn bitmap_alloc_node(i32, i32, i32) -> ptr {
  entry(nb32: i32, flags: i32, node: i32):
    %nbits = zext i64 nb32
    %t = add i64 %nbits, 63
    %nr = udiv i64 %t, 64
    %bytes = mul i64 %nr, 8
    %r = call ptr __kmalloc_node_noprof(%bytes, flags, node)
    ret %r
}

fn bitmap_zalloc_node(i32, i32, i32) -> ptr {
  entry(nb32: i32, flags: i32, node: i32):
    %f2 = or i32 flags, 256
    %r = call ptr bitmap_alloc_node(nb32, %f2, node)
    ret %r
}

fn bitmap_free(ptr) -> void {
  entry(bm: ptr):
    call void kfree(bm)
    ret
}

fn bitmap_from_arr32(ptr, ptr, i32) -> void {
  entry(bm: ptr, buf: ptr, nb32: i32):
    %nbits = zext i64 nb32
    %t = add i64 %nbits, 31
    %hw = udiv i64 %t, 32
    br head(bm, buf, %nbits, %hw, 0)
  head(bm: ptr, buf: ptr, nbits: i64, hw: i64, i: i64):
    %c = icmp.ult i64 i, hw
    condbr %c, body(bm, buf, nbits, hw, i), tail(bm, nbits, hw)
  body(bm: ptr, buf: ptr, nbits: i64, hw: i64, i: i64):
    %pb = gep i32 buf, i
    %x = load i32, %pb
    %xz = zext i64 %x
    %wi = udiv i64 i, 2
    %pw = gep i64 bm, %wi
    store i64 %pw, %xz
    %i1 = add i64 i, 1
    %c2 = icmp.ult i64 %i1, hw
    condbr %c2, hi(bm, buf, nbits, hw, %i1), adv(bm, buf, nbits, hw, %i1)
  hi(bm: ptr, buf: ptr, nbits: i64, hw: i64, i: i64):
    %pb = gep i32 buf, i
    %x = load i32, %pb
    %xz = zext i64 %x
    %xh = shl i64 %xz, 32
    %wi = udiv i64 i, 2
    %pw = gep i64 bm, %wi
    %w = load i64, %pw
    %v = or i64 %w, %xh
    store i64 %pw, %v
    br adv(bm, buf, nbits, hw, i)
  adv(bm: ptr, buf: ptr, nbits: i64, hw: i64, i: i64):
    %i2 = add i64 i, 1
    br head(bm, buf, nbits, hw, %i2)
  tail(bm: ptr, nbits: i64, hw: i64):
    %m = and i64 nbits, 63
    %nz = icmp.ne i64 %m, 0
    condbr %nz, tcheck(bm, nbits, hw), done()
  tcheck(bm: ptr, nbits: i64, hw: i64):
    %hm = sub i64 hw, 1
    %wi = udiv i64 %hm, 2
    %pw = gep i64 bm, %wi
    %w = load i64, %pw
    %lm = call i64 klbm_lastmask(nbits)
    %v = and i64 %w, %lm
    store i64 %pw, %v
    br done()
  done():
    ret
}

fn bitmap_to_arr32(ptr, ptr, i32) -> void {
  entry(buf: ptr, bm: ptr, nb32: i32):
    %nbits = zext i64 nb32
    %t = add i64 %nbits, 31
    %hw = udiv i64 %t, 32
    br head(buf, bm, %nbits, %hw, 0)
  head(buf: ptr, bm: ptr, nbits: i64, hw: i64, i: i64):
    %c = icmp.ult i64 i, hw
    condbr %c, body(buf, bm, nbits, hw, i), tail(buf, nbits, hw)
  body(buf: ptr, bm: ptr, nbits: i64, hw: i64, i: i64):
    %wi = udiv i64 i, 2
    %pw = gep i64 bm, %wi
    %w = load i64, %pw
    %lo = trunc i32 %w
    %pb = gep i32 buf, i
    store i32 %pb, %lo
    %i1 = add i64 i, 1
    %c2 = icmp.ult i64 %i1, hw
    condbr %c2, hi(buf, bm, nbits, hw, %i1), adv(buf, bm, nbits, hw, %i1)
  hi(buf: ptr, bm: ptr, nbits: i64, hw: i64, i: i64):
    %wi = udiv i64 i, 2
    %pw = gep i64 bm, %wi
    %w = load i64, %pw
    %h = lshr i64 %w, 32
    %ht = trunc i32 %h
    %pb = gep i32 buf, i
    store i32 %pb, %ht
    br adv(buf, bm, nbits, hw, i)
  adv(buf: ptr, bm: ptr, nbits: i64, hw: i64, i: i64):
    %i2 = add i64 i, 1
    br head(buf, bm, nbits, hw, %i2)
  tail(buf: ptr, nbits: i64, hw: i64):
    %m = and i64 nbits, 63
    %nz = icmp.ne i64 %m, 0
    condbr %nz, tcheck(buf, nbits, hw), done()
  tcheck(buf: ptr, nbits: i64, hw: i64):
    %neg = sub i64 0, nbits
    %s = and i64 %neg, 31
    %s32 = trunc i32 %s
    %all = sub i32 0, 1
    %mm = lshr i32 %all, %s32
    %hm = sub i64 hw, 1
    %pb = gep i32 buf, %hm
    %x = load i32, %pb
    %v = and i32 %x, %mm
    store i32 %pb, %v
    br done()
  done():
    ret
}
