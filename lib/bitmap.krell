    %pc = popcount i64 %vm
    %w2 = add i64 w, %pc
    br done(%w2)
  done(w: i64):
    %r = trunc i32 w
    ret %r
}

fn __bitmap_weight_andnot(ptr, ptr, i32) -> i32 {
  entry(b1: ptr, b2: ptr, bits32: i32):
    %bits = zext i64 bits32
    %lim = udiv i64 %bits, 64
    br head(b1, b2, %bits, %lim, 0, 0)
  head(b1: ptr, b2: ptr, bits: i64, lim: i64, idx: i64, w: i64):
    %c = icmp.ult i64 idx, lim
    condbr %c, body(b1, b2, bits, lim, idx, w), tail(b1, b2, bits, idx, w)
  body(b1: ptr, b2: ptr, bits: i64, lim: i64, idx: i64, w: i64):
    %p1 = gep i64 b1, idx
    %x = load i64, %p1
    %p2 = gep i64 b2, idx
    %y = load i64, %p2
    %all = sub i64 0, 1
    %ny = xor i64 %y, %all
    %v = and i64 %x, %ny
    %pc = popcount i64 %v
    %w2 = add i64 w, %pc
    %i2 = add i64 idx, 1
    br head(b1, b2, bits, lim, %i2, %w2)
  tail(b1: ptr, b2: ptr, bits: i64, idx: i64, w: i64):
