; SPDX-License-Identifier: GPL-2.0-or-later
; lib/find_bit.c converted to Krell (Phase 1 batch 5).
;
; The C file builds its family from three macros
; (FIND_FIRST_BIT / FIND_NEXT_BIT / FIND_NTH_BIT) instantiated
; per fetch expression; the Krell form keeps that shape --
; one loop nest per function with its fetch inlined.  __ffs
; is ctz, __fls is 63 - clz, hweight_long is popcount, and
; fns() from linux/bitops.h is klfb_fns.  The little-endian
; build has no _le variants (they are __BIG_ENDIAN only).
; find_random_bit calls __bitmap_weight (lib/bitmap.krell)
; and get_random_u32_below (drivers/char/random.c)
; externally, as in C.

extern __bitmap_weight(ptr, i32) -> i32
; get_random_u32_below is a random.h inline in C; for a
; variable ceil (the weight here) it is exactly
; __get_random_u32_below (drivers/char/random.c).
extern __get_random_u32_below(i32) -> i32

; BITMAP_LAST_WORD_MASK(nbits)
fn klfb_lastmask(i64) -> i64 {
  entry(n: i64):
    %m = and i64 n, 63
    %nz = icmp.ne i64 %m, 0
    %sh = shl i64 1, %m
    %mm = sub i64 %sh, 1
    %all = sub i64 0, 1
    %r = select i64 %nz, %mm, %all
    ret %r
}

; fns(): position of the nth set bit (0-based), 64 if fewer.
fn klfb_fns(i64, i64) -> i64 {
  entry(word: i64, n: i64):
    %nt = trunc i32 n
    %nz = zext i64 %nt
    br loop(word, %nz)
  loop(w: i64, k: i64):
    %wz = icmp.eq i64 w, 0
    condbr %wz, done(w), chk(w, k)
  chk(w: i64, k: i64):
    %kz = icmp.eq i64 k, 0
    condbr %kz, done(w), step(w, k)
  step(w: i64, k: i64):
    %wm = sub i64 w, 1
    %w2 = and i64 w, %wm
    %k2 = sub i64 k, 1
    br loop(%w2, %k2)
  done(w: i64):
    %z = icmp.eq i64 w, 0
    %f = ctz i64 w
    %r = select i64 %z, 64, %f
    ret %r
}

; bitmap_read(map, start, 8): the value find_next_clump8
; extracts (bitmap_get_value8 in the C file).
fn klfb_read8(ptr, i64) -> i64 {
  entry(map: ptr, start: i64):
    %idx = udiv i64 start, 64
    %off = and i64 start, 63
    %space = sub i64 64, %off
    %enough = icmp.uge i64 %space, 8
    condbr %enough, one(map, %idx, %off), two(map, start, %idx, %off, %space)
  one(map: ptr, idx: i64, off: i64):
    %p = gep i64 map, idx
    %w = load i64, %p
    %v = lshr i64 %w, off
    %r = and i64 %v, 255
    ret %r
  two(map: ptr, start: i64, idx: i64, off: i64, space: i64):
    %p = gep i64 map, idx
    %w = load i64, %p
    %all = sub i64 0, 1
    %fm = shl i64 %all, off
    %low = and i64 %w, %fm
    %s8 = add i64 start, 8
    %lm = call i64 klfb_lastmask(%s8)
    %i2 = add i64 idx, 1
    %p2 = gep i64 map, %i2
    %w2 = load i64, %p2
    %high = and i64 %w2, %lm
    %a = lshr i64 %low, off
    %b = shl i64 %high, space
    %r = or i64 %a, %b
    ret %r
}

fn _find_first_bit(ptr, i64) -> i64 {
  entry(addr: ptr, size: i64):
    br head(addr, size, 0)
  head(addr: ptr, size: i64, idx: i64):
    %lim = shl i64 idx, 6
    %c = icmp.ult i64 %lim, size
    condbr %c, body(addr, size, idx), done(size)
  body(addr: ptr, size: i64, idx: i64):
    %p = gep i64 addr, idx
    %v = load i64, %p
    %nz = icmp.ne i64 %v, 0
    condbr %nz, found(size, idx, %v), next(addr, size, idx)
  next(addr: ptr, size: i64, idx: i64):
    %i2 = add i64 idx, 1
    br head(addr, size, %i2)
  found(size: i64, idx: i64, v: i64):
    %base = shl i64 idx, 6
    %f = ctz i64 v
    %pos = add i64 %base, %f
    %lt = icmp.ult i64 %pos, size
    %r = select i64 %lt, %pos, size
    ret %r
  done(size: i64):
    ret size
}

fn _find_first_and_bit(ptr, ptr, i64) -> i64 {
  entry(a1: ptr, a2: ptr, size: i64):
    br head(a1, a2, size, 0)
  head(a1: ptr, a2: ptr, size: i64, idx: i64):
    %lim = shl i64 idx, 6
    %c = icmp.ult i64 %lim, size
    condbr %c, body(a1, a2, size, idx), done(size)
  body(a1: ptr, a2: ptr, size: i64, idx: i64):
    %p1 = gep i64 a1, idx
    %x = load i64, %p1
    %p2 = gep i64 a2, idx
    %y = load i64, %p2
    %v = and i64 %x, %y
    %nz = icmp.ne i64 %v, 0
    condbr %nz, found(size, idx, %v), next(a1, a2, size, idx)
  next(a1: ptr, a2: ptr, size: i64, idx: i64):
    %i2 = add i64 idx, 1
    br head(a1, a2, size, %i2)
  found(size: i64, idx: i64, v: i64):
    %base = shl i64 idx, 6
    %f = ctz i64 v
    %pos = add i64 %base, %f
    %lt = icmp.ult i64 %pos, size
    %r = select i64 %lt, %pos, size
    ret %r
  done(size: i64):
    ret size
}

fn _find_first_andnot_bit(ptr, ptr, i64) -> i64 {
  entry(a1: ptr, a2: ptr, size: i64):
    br head(a1, a2, size, 0)
  head(a1: ptr, a2: ptr, size: i64, idx: i64):
    %lim = shl i64 idx, 6
    %c = icmp.ult i64 %lim, size
    condbr %c, body(a1, a2, size, idx), done(size)
  body(a1: ptr, a2: ptr, size: i64, idx: i64):
    %p1 = gep i64 a1, idx
    %x = load i64, %p1
    %p2 = gep i64 a2, idx
    %y = load i64, %p2
    %all = sub i64 0, 1
    %ny = xor i64 %y, %all
    %v = and i64 %x, %ny
    %nz = icmp.ne i64 %v, 0
    condbr %nz, found(size, idx, %v), next(a1, a2, size, idx)
  next(a1: ptr, a2: ptr, size: i64, idx: i64):
    %i2 = add i64 idx, 1
    br head(a1, a2, size, %i2)
  found(size: i64, idx: i64, v: i64):
    %base = shl i64 idx, 6
    %f = ctz i64 v
    %pos = add i64 %base, %f
    %lt = icmp.ult i64 %pos, size
    %r = select i64 %lt, %pos, size
    ret %r
  done(size: i64):
    ret size
}

fn _find_first_and_and_bit(ptr, ptr, ptr, i64) -> i64 {
  entry(a1: ptr, a2: ptr, a3: ptr, size: i64):
    br head(a1, a2, a3, size, 0)
  head(a1: ptr, a2: ptr, a3: ptr, size: i64, idx: i64):
    %lim = shl i64 idx, 6
    %c = icmp.ult i64 %lim, size
    condbr %c, body(a1, a2, a3, size, idx), done(size)
  body(a1: ptr, a2: ptr, a3: ptr, size: i64, idx: i64):
    %p1 = gep i64 a1, idx
    %x = load i64, %p1
    %p2 = gep i64 a2, idx
    %y = load i64, %p2
    %p3 = gep i64 a3, idx
    %z = load i64, %p3
    %xy = and i64 %x, %y
    %v = and i64 %xy, %z
    %nz = icmp.ne i64 %v, 0
    condbr %nz, found(size, idx, %v), next(a1, a2, a3, size, idx)
  next(a1: ptr, a2: ptr, a3: ptr, size: i64, idx: i64):
    %i2 = add i64 idx, 1
    br head(a1, a2, a3, size, %i2)
  found(size: i64, idx: i64, v: i64):
    %base = shl i64 idx, 6
    %f = ctz i64 v
    %pos = add i64 %base, %f
    %lt = icmp.ult i64 %pos, size
    %r = select i64 %lt, %pos, size
    ret %r
  done(size: i64):
    ret size
}

