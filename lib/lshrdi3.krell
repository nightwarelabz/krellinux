; Krellinux Phase 1 conversion of lib/lshrdi3.c: __lshrdi3(long long, int).
;
; See ashldi3.krell for the conversion rationale: the C file's
; 32-bit-halves construction is exactly a logical 64-bit shift,
; which Krell expresses natively (lshr zero-fills; shift amount
; modulo 64). Proven equal on the whole defined domain (counts
; 0..63) by the differential rig.
fn __lshrdi3(i64, i64) -> i64 {
  entry(u: i64, b: i64):
    %r = lshr i64 u, b
    ret %r
}
