; SPDX-License-Identifier: GPL-2.0-only
; lib/math/gcd.c, rewritten in Krell for the Krellinux conversion.
;
; The C file picks between two algorithms on a static key: with an
; efficient __ffs (the x86 case) it runs the binary GCD below; the
; fallback loop computes the same greatest common divisor.  The
; observable result is the true gcd either way, so this form
; follows the binary GCD exactly:
;
;   r = a | b
;   if (!a || !b) return r
;   ;; binary_gcd(a, b), r threaded through:
;   b >>= ctz(b); if (b == 1) return r & -r
;   loop: a >>= ctz(a); if (a == 1) return r & -r
;         if (a == b) return a << ctz(r)
;         if (a < b) swap(a, b); a -= b
;
; __ffs(x) is ctz(x) for the nonzero arguments used here.

fn gcd(i64, i64) -> i64 {
  entry(a: i64, b: i64):
    %r = or i64 a, b
    %za = icmp.eq i64 a, 0
    %zb = icmp.eq i64 b, 0
    %z = or i1 %za, %zb
    condbr %z, done(%r), norm(a, b, %r)
  norm(a: i64, b: i64, r: i64):
    %fb = ctz i64 b
    %b1 = lshr i64 b, %fb
    %is1 = icmp.eq i64 %b1, 1
    condbr %is1, lowbit(r), loop(a, %b1, r)
  lowbit(r: i64):
    %neg = sub i64 0, r
    %res = and i64 r, %neg
    ret %res
  loop(a: i64, b: i64, r: i64):
    %fa = ctz i64 a
    %a1 = lshr i64 a, %fa
    %is1 = icmp.eq i64 %a1, 1
    condbr %is1, lowbit(r), chk(%a1, b, r)
  chk(a: i64, b: i64, r: i64):
    %eq = icmp.eq i64 a, b
    condbr %eq, fin(a, r), ord(a, b, r)
  fin(a: i64, r: i64):
    %fr = ctz i64 r
    %res = shl i64 a, %fr
    ret %res
  ord(a: i64, b: i64, r: i64):
    %lt = icmp.ult i64 a, b
    %na = select i64 %lt, b, a
    %nb = select i64 %lt, a, b
    %a2 = sub i64 %na, %nb
    br loop(%a2, %nb, r)
  done(r: i64):
    ret r
}
